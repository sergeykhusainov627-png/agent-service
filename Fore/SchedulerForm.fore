// ID: SCHEDULER  // идентификатор объекта на стенде (инструмент деплоя ищет объект по нему; класс формы = <Id> + Form)
// Форма «Планировщик» (OBJ1473491) — ЕДИНАЯ форма: базовый планировщик + панель недоступности.
// Одна форма = один класс; имя класса совпадает с именем класса формы-объекта репозитория.
// Контролы не размещаются вручную: динамическая часть описывается текстом (ScreenSpecText) и
// создаётся фабрикой (UiFactory.fore); таблицы/пикеры создаются конструктором, если их нет.
//
// Почему объявления контролов оставлены (это «алиасы», а не место создания). Обработчики обращаются
// к контролам по имени поля (`PlanTable.Items`, `UnavailSummaryMemo.Lines`, `ChainNameEditBox.Text`) —
// это типизированный доступ, и тела обработчиков не пришлось править при переходе на фабрику.
// Сами контролы создают: фабрика (`UiCreateScaled` → `Map_`) — для кнопок/полей/меток/Memo,
// конструктор (`If IsNull(X) Then X := New X.Create`) — для таблиц/пикеров/диалогов. Поле заполняется
// из карты: `X := UiFind(Map_, "X")`. Альтернатива без объявлений — брать контрол из карты по месту
// (`UiButton(Map_, "BtnBuild")`) или объявлять локальные переменные в каждом обработчике: правок
// больше, контроль типов слабее (Variant), зато в классе нет «полей-алиасов» (см. REFERENCE §5.28).
//
// Поток панели недоступности: задать период простоя → «Построить список» (затронутые задачи) →
// отметить флажками → «Не запускать»/«Перепланировать» (для отмеченных) → доп. расписание
// раскладывается равномерно после периода, его можно править и сохранять/загружать в файл.
// В репозиторий пишет только UnavailabilityStore.fore (UNAVAILABILITY / UNAVAILABILITY_PLAN).
//
// Проверка: node tools/fore-lint-check.js Fore  → ожидается 0 предупреждений.

Class SCHEDULERForm: Form
	MetabaseEtlOpenDialog: MetabaseOpenDialog;
	MetabaseListView2: MetabaseListView;
	ChainNameEditBox: EditBox;
	ResponsiblePersonLabel: Label;   // UserTag задачи (только показ; автор/ответственный по объекту)
	ChainStatusTextLabel: Label;
	NextStartTextLabel: Label;
	LastSuccesfullStartTextLabel: Label;
	LabelAvgTimeVal: Label;
	Label1: Label;
	LayoutK: Double;                  // масштаб раскладки формы (обе колонки; макет снят в 1780x1300)
	BtnSelectContainer: Button;       // «Выбрать контейнеры…» → SelectContainerOnClick (MultiSelect)
	BtnAnalyse: Button;               // «Анализ»             → AnalyseButtonOnClick
	BtnApplyPlan: Button;             // «Применить план»     → ApplyPlanOnClick
	CurrentContainer: IMetabaseObjectDescriptor;   // ПЕРВЫЙ из выбранных (запасной список/карточка)
	CurrentContainers: ArrayList;                  // ВСЕ выбранные контейнеры задач (план/анализ)
	CurrentContainerIndex: Integer;                // какой контейнер показывает левый список
	TaskListMerged: ListView;                      // ОБЪЕДИНЁННЫЙ список задач: все выбранные контейнеры
	TaskRows: ArrayList;                           // CTaskRef в порядке строк TaskListMerged (строка ↔ задача)
	TaskListFilter: String;                        // фильтр объединённого списка ("" — все контейнеры)
	Map_: SortedList;                     // карта «имя → контрол», созданных фабрикой
	LblStatus: Label;                     // строка статуса блока «Затронутые задачи»
	MenuMore, MenuUnavail, MenuMark, MenuDecision, MenuPlan, MenuExport, MenuNotify, MenuService: PopupMenu;
	Specs_: ArrayList;                    // описание экрана после сдвига — нужно для пересчёта под окно
	SelectedTaskId_: String;              // задача, выбранная в списке (запоминается при клике по строке)
	LAYOUT_TOP_SHIFT: Integer;            // подъём всей компоновки вверх (единицы макета)
	GROUP_CAPTION: Integer;               // высота подписи GroupBox: клиентская область начинается ниже
	PANEL_X_SHIFT: Integer;               // сдвиг правой колонки вправо (больше зазор между колонками)
	PANEL_X_GROW: Integer;                // расширение блоков/таблиц правой колонки
	
	UnavailStartDatePicker: DateTimePicker;   // дата начала (Kind = «дата»)
	UnavailStartTimePicker: DateTimePicker;   // время начала (Kind = «время»)
	UnavailEndDatePicker: DateTimePicker;     // дата окончания (Kind = «дата»)
	UnavailEndTimePicker: DateTimePicker;     // время окончания (Kind = «время»)
	UnavailSummaryMemo: Memo;             // сообщения о результатах операций (блок «Сообщения»)
	PlanTable: ListView;                  // таблица плана: все пересекающиеся задачи + колонки-«крестики»
	UnavailRecordsList: ListView; // список периодов недоступности из таблицы (выбор периода)
	StoredPlanTable: ListView;            // просмотр плана, сохранённого в таблице (8 колонок)
	UnavailWindow: CUnavailWindow;
	UnavailImpacts: ArrayList;
	UnavailRecords: ArrayList; // записи о недоступности (CUnavailRecord)
	UnavailRecordKeys: ArrayList;         // ключи записей в порядке строк списка
	UnavailSelectedKey: Integer; // выбранная запись недоступности (0 — не выбрана)
	TableFilter: String;                  // текущий фильтр таблицы плана (пусто = без фильтра)
	RespIndex_: SortedList;               // индекс таблицы ответственных: Id задачи → CTaskResponsible
	BtnEditResp: Button; // «Изменить ответственного» → OpenResponsibleForm (форма ответственного)
	RespMenuButton: MenuButton;   // кнопка с выпадающим меню (Forms): свойство Menu = RespPopupMenu
	RespPopupMenu: PopupMenu;     // всплывающее меню для RespMenuButton (пункты строятся перед показом)
	BtnBuild: Button;             // «Построить список»             → BuildAffectedOnClick
	BtnApplyFilter: Button;       // «Фильтр»                       → ApplyFilterOnClick
	BtnResetFilter: Button;       // «Сброс»                        → ResetFilterOnClick
	FilterEditBox: EditBox;       // фильтр таблицы плана: Id/название/БП/ответственный
		Item: IListViewItem;
		Desc: IMetabaseObjectDescriptor;
		Records: ArrayList;
		Rec: CUnavailRecord;
		W: CPlanWindow;
		Windows: ArrayList;
		I: Integer;

	// === 0) Создание формы: свойства формы, контролы и раскладка по макетам ===
	// Привяжите к событию формы OnCreate (Args: IEventArgs). Форма ОДНА: планировщик + панель.
	Sub FormOnCreate(Sender: Object; Args: IEventArgs);
	Begin
		LayoutK := 0.8;               // масштаб: 1.0 — «как в макете»; 0.8 — окно ~1540x1040 (влезает на FullHD)
		LAYOUT_TOP_SHIFT := 20;       // компоновка поднята вверх (единицы макета)
		GROUP_CAPTION := 15;          // подпись GroupBox: клиентская область группы ниже на ~15 единиц
		PANEL_X_SHIFT := 48;          // правая колонка сдвинута вправо: зазор между колонками 72 единицы
		PANEL_X_GROW := 100;          // блоки/таблицы правой колонки шире на 100 единиц (меньше тесноты)
		CreateFormComponents;         // контролы: фабрика по описанию + таблицы/пикеры конструктором
		ConfigurePeriodPickers;       // вид/формат пикеров периода (значения не трогает; вызов повторяемый)
		SetupPlannerLayout;           // размещение таблиц/пикеров планировщика
		SetupPanelLayout; // размещение таблиц/пикеров панели недоступности
		// Привязки (Anchors) НЕ используем: только пиксельные размеры (UI_AUTOSIZE_ON_RESIZE = False),
		// поэтому при развороте окна контролы остаются на своих местах и ничего не «разъезжается».
	End Sub FormOnCreate;

	// === 0.1) Контролы формы ===
	// Динамическая часть (кнопки, поля, метки, Memo, панели) создаётся ФАБРИКОЙ по описанию
	// ScreenSpecText; таблицы, пикеры и диалоги — конструктором, если их нет на форме.
	Sub CreateFormComponents;
	Var
		Ctl: Button;
	Begin
		// 1) Динамическая часть (кнопки, поля, метки, Memo) И рамки блоков — фабрикой по описанию
		//    ScreenSpecText. Строки GROUP идут в описании ПЕРВЫМИ: группы создаются раньше таблиц,
		//    поэтому таблицы/пикеры (их создаёт конструктор ниже) рисуются ПОВЕРХ рамок, а не наоборот.
		Specs_ := UiSpecsFromText(ScreenSpecText);
		UiShiftSpecsTop(Specs_, -LAYOUT_TOP_SHIFT);                        // компоновка поднята вверх
		UiShiftSpecsRight(Specs_, 806, PANEL_X_SHIFT, PANEL_X_GROW);        // правая колонка шире и правее
		Map_ := UiCreateScaled(Self, Specs_, LayoutK);

		// 2) Таблицы, пикеры и диалоги — конструктором, если их нет на форме.
		// ВАЖНО: списки репозитория (MetabaseListView) размещаются на форме ЗАРАНЕЕ —
		// динамическое создание этих компонентов в коде приводило к падению приложения на стенде.
		// Здесь настраиваются только уже существующие контролы (см. раскладку ниже).
		If IsNull(UnavailRecordsList) Then
			UnavailRecordsList := New ListView.Create;
			UnavailRecordsList.Parent := Self;
		End If;
		If IsNull(UnavailStartDatePicker) Then
			UnavailStartDatePicker := New DateTimePicker.Create;
			UnavailStartDatePicker.Parent := Self;
		End If;
		If IsNull(UnavailStartTimePicker) Then
			UnavailStartTimePicker := New DateTimePicker.Create;
			UnavailStartTimePicker.Parent := Self;
		End If;
		If IsNull(UnavailEndDatePicker) Then
			UnavailEndDatePicker := New DateTimePicker.Create;
			UnavailEndDatePicker.Parent := Self;
		End If;
		If IsNull(UnavailEndTimePicker) Then
			UnavailEndTimePicker := New DateTimePicker.Create;
			UnavailEndTimePicker.Parent := Self;
		End If;
		If IsNull(PlanTable) Then
			PlanTable := New ListView.Create;
			PlanTable.Parent := Self;
		End If;
		If IsNull(StoredPlanTable) Then
			StoredPlanTable := New ListView.Create;
			StoredPlanTable.Parent := Self;
		End If;
		// ОБЪЕДИНЁННЫЙ список задач (по всем выбранным контейнерам) — обычный ListView, создаём кодом:
		// у MetabaseListView.Root только ОДИН корень, поэтому объединить контейнеры можно лишь своим
		// списком (заполняется в RefillTaskList; MetabaseListView2 остаётся запасным вариантом).
		If IsNull(TaskListMerged) Then
			TaskListMerged := New ListView.Create;
			TaskListMerged.Parent := Self;
		End If;
		If IsNull(MetabaseEtlOpenDialog) Then
			MetabaseEtlOpenDialog := New MetabaseOpenDialog.Create;
			// невизуальный компонент: Parent не нужен
		End If;

		If IsNull(RespPopupMenu) Then
			RespPopupMenu := New PopupMenu.Create; // невизуальный компонент: Parent не нужен
		End If;
		If IsNull(RespMenuButton) Then
			RespMenuButton := New MenuButton.Create;       // кнопка с меню (Forms): Menu := PopupMenu
			RespMenuButton.Parent := Self;
		End If;

		// 3) Алиасы динамических контролов (имя из описания → поле формы) и подписка кнопок
		Try
			BtnSelectContainer := UiFind(Map_, "BtnSelectContainer");
			ChainNameEditBox := UiFind(Map_, "ChainNameEditBox");
			ResponsiblePersonLabel := UiFind(Map_, "ResponsiblePersonLabel");
			ChainStatusTextLabel := UiFind(Map_, "ChainStatusTextLabel");
			NextStartTextLabel := UiFind(Map_, "NextStartTextLabel");
			LastSuccesfullStartTextLabel := UiFind(Map_, "LastSuccesfullStartTextLabel");
			LabelAvgTimeVal := UiFind(Map_, "LabelAvgTimeVal");
			Label1 := UiFind(Map_, "Label1");
			LblStatus := UiFind(Map_, "LblStatus");
			BtnAnalyse := UiFind(Map_, "BtnAnalyse");
			BtnApplyPlan := UiFind(Map_, "BtnApplyPlan");
			BtnEditResp := UiFind(Map_, "BtnEditResp");
			BtnBuild := UiFind(Map_, "BtnBuild");
			UnavailSummaryMemo := UiFind(Map_, "UnavailSummaryMemo");
			FilterEditBox := UiFind(Map_, "FilterEditBox");
			BtnApplyFilter := UiFind(Map_, "BtnApplyFilter");
			BtnResetFilter := UiFind(Map_, "BtnResetFilter");
		Except On e: Exception Do
			Debug.WriteLine("Форма: контролы не получены из карты фабрики — " + e.Message);
		End Try;

		// --- Подписка динамических кнопок на обработчики ---
		Ctl := UiFind(Map_, "BtnSelectContainer") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := SelectContainerOnClick;
		End If;
		Ctl := UiFind(Map_, "BtnAddContainers") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := AddContainersOnClick;       // добавить контейнеры «в набор» (из другой папки)
		End If;
		Ctl := UiFind(Map_, "BtnAnalyse") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := AnalyseButtonOnClick;
		End If;
		Ctl := UiFind(Map_, "BtnApplyPlan") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := ApplyPlanOnClick;
		End If;
		Ctl := UiFind(Map_, "BtnEditResp") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := EditResponsibleOnClick;     // запись в таблицу ответственных
		End If;
		Ctl := UiFind(Map_, "BtnBuild") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := BuildAffectedOnClick;
		End If;
		Ctl := UiFind(Map_, "BtnApplyFilter") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := ApplyFilterOnClick;
		End If;
		Ctl := UiFind(Map_, "BtnResetFilter") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := ResetFilterOnClick;
		End If;
	End Sub CreateFormComponents;

	// === Описание динамической части экрана (координаты — в единицах макета) ===
	// Формат: Kind;Name;Caption;Left;Top;Width;Height;Handler
	Function ScreenSpecText: String;
	Begin
		Return
			"# Рамки блоков (GROUP). Идут первыми: группы создаются раньше таблиц (их делает конструктор),"
			+ #13 + #10
			+ "# поэтому таблицы/пикеры рисуются поверх рамок. Координаты детей — от КЛИЕНТСКОЙ области группы"
			+ #13 + #10
			+ "# (у GroupBox подпись сверху занимает ~15 px — у детей Top уменьшен на эту величину)."
			+ #13 + #10
			+ "# При переносе на другой размер шрифта/тему подпись может отличаться — тогда правьте только Top детей."
			+ #13 + #10
			+ "GROUP;GrpTaskCard;Карточка задачи;26;110;756;240" + #13 + #10
			+ "GROUP;GrpTasks;Задачи контейнера;26;354;756;600" + #13 + #10
			+ "GROUP;GrpPeriods;Периоды недоступности;818;106;936;170" + #13 + #10
			+ "GROUP;GrpPeriod;Период недоступности;818;314;936;62" + #13 + #10
			+ "GROUP;GrpMsg;Сообщения;818;380;936;118" + #13 + #10
			+ "GROUP;GrpPlan;Раскладка (план);818;504;936;556" + #13 + #10
			+ "GROUP;GrpStored;Сохранённый план (из таблицы);818;1064;936;110" + #13 + #10
			+ "BUTTON;BtnSelectContainer;Выбрать контейнеры…;26;76;190;28;SelectContainerOnClick" + #13 + #10
			+ "BUTTON;BtnAddContainers;Добавить контейнеры…;566;76;228;28;AddContainersOnClick" + #13 + #10
			+ "EDIT;ChainNameEditBox;;226;76;330;28;" + #13 + #10
			+ "LABEL;LblCapResponsible;Ответственный (по объекту):;12;15;200;20;Parent=GrpTaskCard" + #13 + #10
			+ "LABEL;ResponsiblePersonLabel;;232;15;430;20;Parent=GrpTaskCard" + #13 + #10
			+ "LABEL;LblCapState;Состояние задачи:;12;43;200;20;Parent=GrpTaskCard" + #13 + #10
			+ "LABEL;ChainStatusTextLabel;;232;43;430;20;Parent=GrpTaskCard" + #13 + #10
			+ "LABEL;LblCapNextStart;Ближайший запуск:;12;71;200;20;Parent=GrpTaskCard" + #13 + #10
			+ "LABEL;NextStartTextLabel;;232;71;430;20;Parent=GrpTaskCard" + #13 + #10
			+ "LABEL;LblCapLastStart;Последний успешный запуск:;12;99;200;20;Parent=GrpTaskCard" + #13 + #10
			+ "LABEL;LastSuccesfullStartTextLabel;;232;99;430;20;Parent=GrpTaskCard" + #13 + #10
			+ "LABEL;LblCapAvgTime;Средняя длительность:;12;127;200;20;Parent=GrpTaskCard" + #13 + #10
			+ "LABEL;LabelAvgTimeVal;;232;127;430;20;Parent=GrpTaskCard" + #13 + #10
			+ "LABEL;LblCapRespTask;Ответственный (по задаче):;12;155;200;20;Parent=GrpTaskCard" + #13 + #10
			+ "LABEL;Label1;;232;155;430;20;Parent=GrpTaskCard" + #13 + #10
			+ "BUTTON;BtnEditResp;Изменить ответственного;12;183;230;28;EditResponsibleOnClick;Parent=GrpTaskCard"
			+ #13 + #10
			+ "BUTTON;BtnAnalyse;Анализ;26;988;150;30;AnalyseButtonOnClick" + #13 + #10
			+ "BUTTON;BtnApplyPlan;Применить план;186;988;200;30;ApplyPlanOnClick" + #13 + #10
			+ "BUTTON;BtnMenuMore;Ещё ▾;396;988;180;30;MenuMoreOnClick" + #13 + #10
			+ "BUTTON;BtnMenuUnavail;Недоступности ▾;818;76;230;28;MenuUnavailOnClick" + #13 + #10
			+ "BUTTON;BtnMenuNotify;Уведомления ▾;1058;76;230;28;MenuNotifyOnClick" + #13 + #10
			+ "MEMO;UnavailSummaryMemo;;4;45;928;50;;;Parent=GrpMsg" + #13 + #10
			+ "EDIT;FilterEditBox;;14;20;400;28;Parent=GrpPlan" + #13 + #10
			+ "BUTTON;BtnApplyFilter;Фильтр;428;20;140;28;ApplyFilterOnClick;Parent=GrpPlan" + #13 + #10
			+ "BUTTON;BtnResetFilter;Сброс;576;20;140;28;ResetFilterOnClick;Parent=GrpPlan" + #13 + #10
			+ "BUTTON;BtnRecalcPlan;Пересчитать план;724;20;200;28;RecalcPlanOnClick;Parent=GrpPlan" + #13 + #10
			+ "BUTTON;BtnBuild;Построить список;818;1180;170;28;BuildAffectedOnClick" + #13 + #10
			+ "BUTTON;BtnMenuMark;Отметки ▾;998;1180;180;28;MenuMarkOnClick" + #13 + #10
			+ "BUTTON;BtnMenuDecision;Решение ▾;1186;1180;200;28;MenuDecisionOnClick" + #13 + #10
			+ "LABEL;LblStatus;;4;52;900;20;Parent=GrpPlan" + #13 + #10
			+ "BUTTON;BtnMenuPlan;План ▾;818;1214;220;28;MenuPlanOnClick" + #13 + #10
			+ "BUTTON;BtnMenuExport;Выгрузка ▾;1046;1214;240;28;MenuExportOnClick" + #13 + #10
			+ "BUTTON;BtnMenuService;Сервис ▾;1294;1214;220;28;MenuServiceOnClick";
	End Function ScreenSpecText;

	Sub SelectContainerOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Containers: ArrayList;
	Begin
		// ⚠ Диалог репозитория при MultiSelect := True «теряет» выделение при переходе по папкам,
		// поэтому собрать контейнеры из РАЗНЫХ папок одним выбором не получается: «Выбрать контейнеры…»
		// ЗАМЕНЯЕТ набор, а «Добавить контейнеры…» (BtnAddContainers) — ДОБАВЛЯЕТ к нему (пункт
		// «Ещё ▾» → «Добавить контейнеры… (из другой папки)») — так и набирается несколько контейнеров.
		Containers := PickContainers;
		If (IsNull(Containers)) Or (Containers.Count = 0) Then
			Debug.WriteLine("Планировщик: выбор контейнеров отменён — набор не меняем");
			Return;
		End If;
		FillTasksFromContainers(Containers);           // ЗАМЕНА набора
	End Sub SelectContainerOnClick;

	// Диалог выбора контейнеров задач. Возвращает список выбранных (пустой — отмена/ничего не выбрано).
	Function PickContainers: ArrayList;
	Var
		Filter: IMetabaseDialogClassFilter;
		Objects: IMetabaseObjectDescriptorList;
		Containers: ArrayList;
		Cont: IMetabaseObjectDescriptor;
		I: Integer;
	Begin
		Containers := New ArrayList.Create;
		// ВНИМАНИЕ: у IMetabaseDialogMetaclassFilter свойство ObjectMetaclass имеет тип
		// MetabaseObjectMetaclass (ГРУППЫ классов: SCHEDULEDTASK_CLASS = 5376, …), а не
		// MetabaseObjectClass. Чтобы фильтровать по КОНКРЕТНОМУ классу — используем ClassFilter
		// со свойством ObjectClass (тип MetabaseObjectClass, §5.18).
		Filter := New MetabaseDialogClassFilter.Create;
		Filter.ObjectClass := MetabaseObjectClass.KE_CLASS_TASK_CONTAINTER;
		Filter.Description := "Контейнер запланированных задач";
		MetabaseEtlOpenDialog.Filters.Clear;
		MetabaseEtlOpenDialog.Filters.AddFilter(Filter);
		MetabaseEtlOpenDialog.FilterIndex := 0;
		// НЕСКОЛЬКО контейнеров за один выбор: MultiSelect = True, выбранные — в Objects
		// (IMetabaseObjectDescriptorList; см. пример справки по MetabaseOpenDialog).
		MetabaseEtlOpenDialog.MultiSelect := True;

		If Not MetabaseEtlOpenDialog.Execute(Self) Then
			Return Containers;                         // отмена диалога — пустой список
		End If;
		Objects := Null;
		Try
			Objects := MetabaseEtlOpenDialog.Objects;
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: список выбранных контейнеров — " + e.Message);
			Objects := Null;
		End Try;
		If Not IsNull(Objects) Then
			For I := 0 To Objects.Count - 1 Do
				Cont := Objects.Item(I) As IMetabaseObjectDescriptor;
				If Not IsNull(Cont) Then
					Containers.Add(Cont);
				End If;
			End For;
		End If;
		If Containers.Count = 0 Then
			// резерв: диалог вернул единственный объект (или Objects недоступен)
			Cont := MetabaseEtlOpenDialog.Object;
			If Not IsNull(Cont) Then
				Containers.Add(Cont);
			End If;
		End If;
		Return Containers;
	End Function PickContainers;

	// «Добавить контейнеры…» — к уже выбранным контейнерам добавляются новые (в т. ч. из ДРУГОЙ папки);
	// повторы по Id пропускаются. Так набирается набор при «слетающем» выделении в диалоге.
	Sub AddContainersOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Picked, Merged: ArrayList;
		Added: Integer;
	Begin
		Picked := PickContainers;
		If (IsNull(Picked)) Or (Picked.Count = 0) Then
			Debug.WriteLine("Планировщик: добавление контейнеров отменено");
			Return;
		End If;
		Merged := MergeContainers(CurrentContainers, Picked);   // без дублей по Id (в верхнем регистре)
		Added := Merged.Count - ContainersCount(CurrentContainers);
		FillTasksFromContainers(Merged);
		If Added > 0 Then
			WinApplication.InformationBox("Добавлено контейнеров: " + Added.ToString
				+ ". Всего выбрано: " + Merged.Count.ToString + ".");
		Else
			WinApplication.InformationBox("Новых контейнеров нет — выбранные уже в наборе.");
		End If;
	End Sub AddContainersOnClick;

	// «Очистить выбор контейнеров» (пункт меню «Ещё ▾»)
	Sub ClearContainersOnClick;
	Begin
		If ContainersCount(CurrentContainers) = 0 Then
			Return;
		End If;
		FillTasksFromContainers(New ArrayList.Create);
	End Sub ClearContainersOnClick;

	// Убрать один контейнер из набора (пункт меню «Убрать контейнер «…»»)
	Sub RemoveContainerFromSet(Id: String);
	Var
		Rest: ArrayList;
		Cont: IMetabaseObjectDescriptor;
		I: Integer;
	Begin
		Rest := New ArrayList.Create;
		If Not IsNull(CurrentContainers) Then
			For I := 0 To CurrentContainers.Count - 1 Do
				Cont := CurrentContainers.Item(I) As IMetabaseObjectDescriptor;
				If (Not IsNull(Cont)) And (String.ToUpper(Cont.Id) <> String.ToUpper(Id)) Then
					Rest.Add(Cont);
				End If;
			End For;
		End If;
		FillTasksFromContainers(Rest);      // набор мог стать пустым — это нормально
	End Sub RemoveContainerFromSet;

	// Контейнеры выбираются СПИСКОМ, задачи «подтягиваются» из ВСЕХ выбранных (план переноса, анализ,
	// применение плана). Левый список задач: при ОДНОМ контейнере — штатный MetabaseListView2 (Root),
	// при ДВУХ и более — объединённый TaskListMerged (см. RefillTaskList); фильтр объединённого
	// списка переключается пунктом меню «Ещё ▾» (NextTaskListFilter).
	Sub FillTasksFromContainers(Containers: ArrayList);
	Var
		Tasks: ArrayList;
		Text: String;
	Begin
		If IsNull(Containers) Then
			Containers := New ArrayList.Create;
		End If;
		CurrentContainers := Containers;
		CurrentContainerIndex := 0;
		CurrentContainer := Null;
		If Containers.Count = 0 Then
			ChainNameEditBox.Text := "";
			TaskListFilter := "";
			RefillTaskList;                            // покажет «Контейнеры задач не выбраны»
			Debug.WriteLine("Планировщик: набор контейнеров пуст");
			Return;
		End If;
		CurrentContainer := Containers.Item(0) As IMetabaseObjectDescriptor;
		Text := ContainersText(Containers);
		If Containers.Count > 1 Then
			Text := "(" + Containers.Count.ToString + ") " + Text;
		End If;
		ChainNameEditBox.Text := Text;

		// задачи всех контейнеров: заодно проверяем, что контейнеры читаются (O(1) по каждому)
		Tasks := CollectTasksFromContainers(Containers);

		// Список контейнера (Root — только ОДИН контейнер) держим запасным путём, а показываем
		// ОБЪЕДИНЁННЫЙ список задач по всем выбранным контейнерам (RefillTaskList, фильтр — все).
		If Not IsNull(MetabaseListView2) Then
			MetabaseListView2.Root := CurrentContainer;
		End If;
		TaskListFilter := "";
		RefillTaskList;

		// Ответственные: индекс читаем один раз на выбор; подпись обновляется по клику в списке
		RespIndex_ := LoadResponsibleIndex(RESP_TABLE_ID);
		Label1.Text := "выберите задачу в списке";   // подпись «Ответственный (по задаче):» — статичный Label
		Debug.WriteLine("Планировщик: контейнеров — " + Containers.Count.ToString
			+ ", задач всего — " + Tasks.Count.ToString + " (" + Text + ")");
	End Sub FillTasksFromContainers;

	// Переключить ФИЛЬТР объединённого списка задач: «все контейнеры» → по одному контейнеру → снова все.
	// Сам план и анализ всегда строятся по ВСЕМ выбранным контейнерам — фильтр касается только показа.
	Sub NextTaskListFilter;
	Var
		NextId: String;
		Pos, I: Integer;
	Begin
		If IsNull(CurrentContainers) Or (CurrentContainers.Count = 0) Then
			WinApplication.InformationBox("Сначала выберите контейнеры задач («Выбрать контейнеры…»)");
			Return;
		End If;
		NextId := "";
		If TaskListFilter = "" Then
			NextId := (CurrentContainers.Item(0) As IMetabaseObjectDescriptor).Id;
		Else
			Pos := -1;
			For I := 0 To CurrentContainers.Count - 1 Do
				If (CurrentContainers.Item(I) As IMetabaseObjectDescriptor).Id = TaskListFilter Then
					Pos := I;
				End If;
			End For;
			If (Pos >= 0) And (Pos + 1 <= CurrentContainers.Count - 1) Then
				NextId := (CurrentContainers.Item(Pos + 1) As IMetabaseObjectDescriptor).Id;
			End If;
		End If;
		TaskListFilter := NextId;
		RefillTaskList;
	End Sub NextTaskListFilter;

	// Текст текущего фильтра объединённого списка (для статуса и подписи пункта меню)
	Function TaskListFilterText: String;
	Begin
		If TaskListFilter = "" Then
			Return "все контейнеры";
		End If;
		Return TaskListFilter;
	End Function TaskListFilterText;

	// Заполнить ОБЪЕДИНЁННЫЙ список задач по всем выбранным контейнерам (с учётом фильтра).
	// ⚠ MetabaseListView.Root принимает только ОДИН контейнер, поэтому строки набираем сами, а
	// соответствие «строка ↔ задача» держим в TaskRows (по индексу строки). Если заполнение не
	// удалось — показываем штатный список контейнера (MetabaseListView2) и пишем причину в Debug.
	Sub RefillTaskList;
	Var
		Refs: ArrayList;
		Ref: CTaskRef;
		Item: IListViewItem;
		Task: IScheduledTask;
		StateText: String;
		I, Shown, Cnt: Integer;
	Begin
		TaskRows := New ArrayList.Create;
		If IsNull(TaskListMerged) Then
			Return;                                  // объединённого списка нет — работает список контейнера
		End If;
		Cnt := ContainersCount(CurrentContainers);
		// Ничего не выбрано: пустой список + подсказка, как набрать контейнеры из разных папок
		If Cnt = 0 Then
			TaskListMerged.Visible := False;
			If Not IsNull(MetabaseListView2) Then
				MetabaseListView2.Visible := True;
				Try
					MetabaseListView2.Root := Null;        // список пуст: контейнеры не выбраны
				Except On e: Exception Do
					Debug.WriteLine("Планировщик: сброс Root списка задач — " + e.Message);
				End Try;
			End If;
			SetMemoLines(UnavailSummaryMemo, "Контейнеры задач не выбраны."
				+ UNAVAIL_CRLF + "«Выбрать контейнеры…» — набор целиком, «Ещё ▾ → Добавить контейнеры…» — "
				+ "добавить ещё (в т. ч. из другой папки: в диалоге выделение «слетает» при смене папки).");
			Debug.WriteLine("Планировщик: список задач — контейнеры не выбраны");
			Return;
		End If;
		// ОДИН контейнер: показываем штатный список компонента (`MetabaseListView.Root`) — у него своя
		// реакция на ДВОЙНОЙ КЛИК (открытие задачи) и системное меню элементов. Объединённый список
		// нужен там, где `Root` не справляется — при ДВУХ и более контейнерах.
		If Cnt = 1 Then
			If Not IsNull(MetabaseListView2) Then
				TaskListMerged.Visible := False;
				MetabaseListView2.Visible := True;
				MetabaseListView2.Root := CurrentContainer;    // на случай смены выбора
				SetMemoLines(UnavailSummaryMemo, "Список задач: контейнер «"
					+ ContainersText(CurrentContainers) + "» (штатный список: двойной клик по задаче — открыть)."
					+ UNAVAIL_CRLF + "План переноса и анализ строятся по всем выбранным контейнерам.");
				Debug.WriteLine("Планировщик: список задач — штатный список контейнера (контейнеров "
					+ Cnt.ToString + ")");
				Return;
			End If;
		End If;
		Refs := CollectTaskRefs(CurrentContainers);
		Shown := 0;
		Try
			TaskListMerged.Items.BeginUpdate;
			TaskListMerged.Items.Clear;
			For I := 0 To Refs.Count - 1 Do
				Ref := Refs.Item(I) As CTaskRef;
				If (TaskListFilter = "") Or (Ref.ContainerId = TaskListFilter) Then
					StateText := "";
					Task := BindScheduledTask(Ref.Descriptor);
					If Not IsNull(Task) Then
						StateText := GetTaskStateText(Task.State);
					End If;
					TaskListMerged.Items.Add(Ref.TaskId);
					Item := TaskListMerged.Items.Item(TaskListMerged.Items.Count - 1);
					Item.ColumnText(1) := Ref.ContainerId;
					Item.ColumnText(2) := Ref.Name;
					Item.ColumnText(3) := StateText;
					TaskRows.Add(Ref);               // порядок строк и TaskRows совпадает
					Shown := Shown + 1;
				End If;
			End For;
			TaskListMerged.Items.EndUpdate;
			TaskListMerged.Visible := True;
			If Not IsNull(MetabaseListView2) Then
				MetabaseListView2.Visible := False;       // показываем объединённый список
			End If;
			SetMemoLines(UnavailSummaryMemo, "Список задач (объединённый): контейнеров "
				+ Cnt.ToString + " — " + ContainersText(CurrentContainers)
				+ "; фильтр «" + TaskListFilterText + "»; строк " + Shown.ToString + "."
				+ UNAVAIL_CRLF + "План переноса и анализ строятся по ВСЕМ выбранным контейнерам.");
			Debug.WriteLine("Планировщик: объединённый список задач — строк " + Shown.ToString
				+ " из " + Refs.Count.ToString + ", фильтр «" + TaskListFilterText + "»");
		Except On e: Exception Do
			// Объединённый список не заполнился — возвращаемся к списку контейнера (Root := первый)
			Debug.WriteLine("Планировщик: объединённый список задач не заполнился — " + e.Message
				+ "; показываем задачи первого контейнера");
			TaskRows := New ArrayList.Create;
			TaskListMerged.Visible := False;
			If Not IsNull(MetabaseListView2) Then
				MetabaseListView2.Visible := True;
			End If;
			SetMemoLines(UnavailSummaryMemo, "Список задач: задачи контейнера «"
				+ ContainersText(CurrentContainers) + "» (объединённый список недоступен: "
				+ e.Message + ").");
		End Try;
	End Sub RefillTaskList;

	// Задача, соответствующая строке ОБЪЕДИНЁННОГО списка (Null — не определили).
	// Index строки берём у SelectedItem/FocusedItem (привод к IMetabaseListViewItem не нужен).
	Function TaskRowDescriptor(List: ListView): IMetabaseObjectDescriptor;
	Var
		Item: IListViewItem;
		Index: Integer;
	Begin
		If IsNull(List) Or IsNull(TaskRows) Then
			Return Null;
		End If;
		Item := List.SelectedItem;
		If IsNull(Item) Then
			Item := List.FocusedItem;                // клик мог ещё не изменить SelectedItem
		End If;
		If IsNull(Item) Then
			Return Null;
		End If;
		Index := Item.Index;
		If (Index < 0) Or (Index >= TaskRows.Count) Then
			Return Null;
		End If;
		Return (TaskRows.Item(Index) As CTaskRef).Descriptor;
	End Function TaskRowDescriptor;

	// Задача, выбранная в списке задач: сначала объединённый список (TaskRows), затем список контейнера
	Function SelectedTaskDescriptor: IMetabaseObjectDescriptor;
	Var
		Desc: IMetabaseObjectDescriptor;
	Begin
		Desc := Null;
		If Not IsNull(TaskListMerged) And TaskListMerged.Visible Then
			Desc := TaskRowDescriptor(TaskListMerged);
		End If;
		If IsNull(Desc) Then
			Desc := SelectedObjectDescriptor(MetabaseListView2);
		End If;
		Return Desc;
	End Function SelectedTaskDescriptor;

	// Клик по строке ОБЪЕДИНЁННОГО списка задач → карточка задачи (та же, что и у списка контейнера)
	Sub TaskListMergedOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		List: ListView;
	Begin
		List := Null;
		Try
			List := Sender As ListView;
		Except On e: Exception Do
			List := Null;
		End Try;
		If IsNull(List) Then
			List := TaskListMerged;
		End If;
		ShowTaskCard(TaskRowDescriptor(List));
	End Sub TaskListMergedOnClick;

	// Колонки объединённого списка задач (обычный ListView — строки заполняем сами):
	// «Задача | Контейнер | Название | Состояние». Набор пересоздаём, если он не тот (4 колонки).
	Sub SetupMergedTaskList(LV: ListView);
	Var
		Col: IListViewColumn;
	Begin
		Try
			LV.Style := ListViewStyle.Report;
			LV.GridLines := True;
			LV.RowSelect := True;
			LV.ShowColumnHeaders := True;
			LV.ReadOnly := True;
			If LV.Columns.Count <> 4 Then
				LV.Columns.Clear;
				Col := LV.Columns.Add;
				SetListColumn(Col, "Задача", 240, False, TextAlignment.Left);
				Col := LV.Columns.Add;
				SetListColumn(Col, "Контейнер", 150, False, TextAlignment.Left);
				Col := LV.Columns.Add;
				SetListColumn(Col, "Название", 200, True, TextAlignment.Left);
				Col := LV.Columns.Add;
				SetListColumn(Col, "Состояние", 130, False, TextAlignment.Left);
			Else
				SetColumnsAutoSize(LV.Columns);
			End If;
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: колонки объединённого списка задач — " + e.Message);
		End Try;
	End Sub SetupMergedTaskList;

	Sub MetabaseListView2OnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		List: MetabaseListView;
		Stage: String;
	Begin
		// 1) Компонент-источник события. Привод «Sender As <компонент>» берём в Try: если он не
		//    сработает, обработчик просто ничего не сделает (форма останется открытой), а в журнале
		//    появится строка. Запасной путь — поле самой формы (обработчик привязан к этому списку).
		Stage := "получение списка (Sender)";
		List := Null;
		Try
			List := Sender As MetabaseListView;
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: Sender как MetabaseListView не получен — " + e.Message);
			List := Null;
		End Try;
		If IsNull(List) Then
			List := MetabaseListView2;
		End If;
		If IsNull(List) Then
			Debug.WriteLine("Планировщик: список задач недоступен (ни Sender, ни MetabaseListView2)");
			Return;
		End If;

		// 2) Карточка задачи. ВАЖНО: необработанное исключение внутри обработчика события модальной
		//    формы прерывает модальный цикл — окно закрывается (симптом «кликнул по задаче — форма
		//    исчезла»). Поэтому вызов карточки идёт «по шагам» в Try: сбой логируется и попадает
		//    в статусную метку, а форма остаётся открытой.
		//    ⚠ Привод «SelectedItem As IMetabaseListViewItem» на стенде НЕ работает: описание объекта
		//    берём документированным способом — SelectedObjects (TaskContainerLib).
		Stage := "описание объекта (SelectedObjects)";
		Try
			ShowTaskCard(SelectedObjectDescriptor(List));
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: список задач — сбой на шаге «" + Stage + "»: " + e.Message);
			ChainStatusTextLabel.Text := "сбой на шаге «" + Stage + "»: " + e.Message;
		End Try;
	End Sub MetabaseListView2OnClick;

	// Карточка задачи по её описанию — общая для объединённого списка и списка контейнера.
	// ВАЖНО: необработанное исключение внутри обработчика события модальной формы прерывает
	// модальный цикл — окно закрывается (симптом «кликнул по задаче — форма исчезла»). Поэтому всё
	// чтение идёт «по шагам» в одном Try: сбой логируется и попадает в статусную метку, а форма
	// остаётся открытой.
	Sub ShowTaskCard(TaskDesc: IMetabaseObjectDescriptor);
	Var
		Task: IScheduledTask;
		Props: IScheduledTaskProperties;
		Stage: String;
	Begin
		Stage := "описание объекта";
		Task := Null;
		Try
			If Not IsNull(TaskDesc) Then
				Stage := "имя задачи";
				ChainNameEditBox.Text := TaskDesc.Id;
				SelectedTaskId_ := TaskDesc.Id;      // запоминаем выбор — его используют «Ответственный…» и меню

				Stage := "открытие задачи (Bind)";
				Task := BindScheduledTask(TaskDesc);

				If IsNull(Task) Then
					Stage := "Bind вернул пусто";
					ChainStatusTextLabel.Text := "задача не открылась (Bind)";
				Else
					Stage := "свойства задачи";
					Props := Task.Properties;
					If IsNull(Props) Then
						ResponsiblePersonLabel.Text := "";
						NextStartTextLabel.Text := "—";
					Else
						Stage := "ответственный (UserTag)";
						ResponsiblePersonLabel.Text := Props.UserTag;
						Stage := "расписание (Period)";
						NextStartTextLabel.Text := GetTaskPeriodText(Props);
					End If;

					Stage := "состояние задачи";
					ChainStatusTextLabel.Text := GetTaskStateText(Task.State);
					Stage := "последний успешный запуск";
					LastSuccesfullStartTextLabel.Text := GetLastSucceededText(Task);
					Stage := "средняя длительность";
					LabelAvgTimeVal.Text := GetAverageDurationText(Task);
				End If;

				// Ответственный по задаче — из таблицы RESPONSIBLE_FOR_TASK (а не из свойств задачи)
				Stage := "ответственный по задаче (таблица)";
				ShowTaskResponsible(TaskDesc.Id);
			End If;
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: карточка задачи — сбой на шаге «" + Stage + "»: " + e.Message);
			ChainStatusTextLabel.Text := "сбой на шаге «" + Stage + "»: " + e.Message;
		End Try;
	End Sub ShowTaskCard;

	// Id задачи, выбранной в списке (пусто — ничего не выбрано)
	Function SelectedTaskId: String;
	Var
		Desc: IMetabaseObjectDescriptor;
	Begin
		// 1) задача, запомненная при клике по строке списка (самый надёжный путь), 2) выделение «на месте»
		If SelectedTaskId_ <> "" Then
			Return SelectedTaskId_;
		End If;
		Desc := Null;
		// выделение «на месте»: сначала объединённый список задач, затем штатный список контейнера
		Desc := SelectedTaskDescriptor;
		If IsNull(Desc) Then
			Return "";
		End If;
		Return Desc.Id;
	End Function SelectedTaskId;

	// Значение строки «Ответственный (по задаче):» в карточке (подпись — статичный Label LblCapRespTask):
	// данные берём из таблицы RESPONSIBLE_FOR_TASK (индекс RespIndex_ читается на контейнер).
	Sub ShowTaskResponsible(TaskId: String);
	Var
		Row: CTaskResponsible;
	Begin
		Try
			Row := Null;
			If (Not IsNull(RespIndex_)) And (TaskId <> "") Then
				Row := FindTaskResponsibleInIndex(RespIndex_, TaskId);
			End If;
			If IsNull(Row) Then
				Label1.Text := "— (не задан)";
			Else
				// показываем и почту: она подставляется при выборе ранее использованного ответственного
				Label1.Text := Row.ResponsibleUser;
				If String.Trim(Row.Mail) <> "" Then
					Label1.Text := Label1.Text + " (" + String.Trim(Row.Mail) + ")";
				End If;
			End If;
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: ответственный по задаче — " + e.Message);
		End Try;
		// Меню «Ранее использованные ответственные» наполняем заранее (кнопка показывает его сама)
		RespMenuBuild;
	End Sub ShowTaskResponsible;

	// Подпись пункта меню «ручной ввод» (одна и та же при построении меню и при выборе)
	Function ManualRespCaption: String;
	Begin
		Return "Ввести вручную…";
	End Function ManualRespCaption;

	// Запись ответственного по задаче (пусто — снять): БП задачи → SaveTaskResponsible →
	// перечитать индекс и подпись. True — успех. Ошибки наружу не выпускаются.
	Function ApplyResponsible(TaskId: String; NewResp: String): Boolean;
	Var
		BaName, Mail: String;
		Desc: IMetabaseObjectDescriptor;
	Begin
		If TaskId = "" Then
			Return False;
		End If;
		BaName := "";
		Try
			Desc := MetabaseClass.Active.ItemById(TaskId);
			If Not IsNull(Desc) Then
				BaName := GetTaskBusinessAppName(Desc);
			End If;
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: бизнес-приложение задачи «" + TaskId + "» — " + e.Message);
		End Try;
		// Почту подставляем по ФИО: у ранее использованного ответственного адрес уже есть в таблице.
		// (Раньше здесь передавался Null — «сохранить прежнюю почту», и у нового ответственного
		//  адрес оставался пустым, поэтому уведомления ему не уходили.)
		Mail := LoadResponsibleMail(RESP_TABLE_ID, NewResp);
		If SaveTaskResponsible(RESP_TABLE_ID, RESP_FIELD_TASK, RESP_FIELD_BA, RESP_FIELD_RESPONSIBLE,
			RESP_FIELD_MAIL, TaskId, BaName, String.Trim(NewResp), Mail) Then
			RespIndex_ := LoadResponsibleIndex(RESP_TABLE_ID);       // перечитать индекс
			ShowTaskResponsible(TaskId);
			Return True;
		End If;
		Return False;
	End Function ApplyResponsible;

	// Форма ведения ответственного (ФИО + почта): Fore/ResponsibleForm.fore, класс RESPONSIBLEForm.
	// Задача передаётся документированным способом — командой формы:
	//   SendCommand("EditResponsible", TaskId)  →  ResponsibleFormOnCommand (Args.Command / Args.Argument).
	Sub OpenResponsibleForm(TaskId: String);
	Var
		EditForm: RESPONSIBLEForm;
		Sent: Variant;
	Begin
		If TaskId = "" Then
			WinApplication.InformationBox("Выберите задачу в списке");
			Return;
		End If;
		Try
			EditForm := New RESPONSIBLEForm.CreateForm(Self As IWin32Window);
			Sent := EditForm.SendCommand("EditResponsible", TaskId);   // SendCommand(Command; Argument): Variant
			Debug.WriteLine("Планировщик: форма ответственного, команда — " + UnvVarToStr(Sent));
			EditForm.ShowModal;                                        // закрывается крестиком окна
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: форма ответственного — " + e.Message);
			WinApplication.InformationBox("Не удалось открыть форму ответственного: " + e.Message);
		End Try;
		RespIndex_ := LoadResponsibleIndex(RESP_TABLE_ID);             // после закрытия — перечитать
		ShowTaskResponsible(TaskId);
	End Sub OpenResponsibleForm;

	// «Изменить ответственного» — форма ведения ответственного УЖЕ для выбранной задачи: Id берём из
	// выделенной строки списка (MetabaseListView2, запоминается при клике), поэтому в окне сразу
	// подставляются ФИО и почта из RESPONSIBLE_FOR_TASK, а не пустые поля.
	Sub EditResponsibleOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		TaskId: String;
	Begin
		TaskId := SelectedTaskId;
		If TaskId = "" Then
			WinApplication.InformationBox("Сначала выберите задачу в списке задач");
			Return;
		End If;
		Debug.WriteLine("Планировщик: «Изменить ответственного» — задача " + TaskId);
		OpenResponsibleForm(TaskId);
	End Sub EditResponsibleOnClick;

	// Пункты меню строятся ПЕРЕД показом (вызывается из ShowTaskResponsible и при создании формы):
	// ранее использованные
	// ответственные из таблицы (по алфавиту) + пункт «Ввести вручную…». Если задача не выбрана — подсказка.
	Sub RespMenuBuild;
	Var
		Names: ArrayList;
		Item: MenuItem;
		TaskId: String;
		I: Integer;
	Begin
		Try
			If Not IsNull(RespPopupMenu) Then
				RespPopupMenu.Items.Clear;
				TaskId := SelectedTaskId;
				Names := LoadResponsibleNames(RESP_TABLE_ID);
				If TaskId = "" Then
					Item := New MenuItem.Create;
					Item.Text := "Сначала выберите задачу в списке";
					Item.Enabled := False;
					RespPopupMenu.Items.Add(Item);
				Else
					If Names.Count = 0 Then
						Item := New MenuItem.Create;
						Item.Text := "Ранее ответственные не задавались";
						Item.Enabled := False;
						RespPopupMenu.Items.Add(Item);
					Else
						For I := 0 To Names.Count - 1 Do
							Item := New MenuItem.Create;
							Item.Text := Names.Item(I) As String;
							Item.OnClick := RespMenuPickOnClick;
							RespPopupMenu.Items.Add(Item);
						End For;
					End If;
					// последний пункт — ручной ввод (откроется форма ведения ответственного)
					Item := New MenuItem.Create;
					Item.Text := ManualRespCaption;
					Item.OnClick := RespMenuPickOnClick;
					RespPopupMenu.Items.Add(Item);
				End If;
			End If;
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: построение меню ответственных — " + e.Message);
		End Try;
	End Sub RespMenuBuild;

	// Выпадающий список ответственных: MenuButton (свойство Menu = RespPopupMenu).
	// Меню наполняется ЗАРАНЕЕ (MenuButton показывает его сам), поэтому пункты обновляем при выборе
	// задачи и после любой записи ответственного — см. ShowTaskResponsible / RespMenuBuild.
	// Страховка: если кнопка по каким-то причинам не всплывает меню сама — показываем из обработчика.
	Sub RespMenuButtonOnClick(Sender: Object; Args: IMouseEventArgs);
	Begin
		RespMenuBuild;
		MenuShow(Sender, Args, RespPopupMenu);
	End Sub RespMenuButtonOnClick;

	// Выбран пункт меню: имя ответственного (сразу пишем в таблицу) либо «Ввести вручную…»
	// (открывается форма ведения ответственного — ФИО + почта).
	Sub RespMenuPickOnClick(Sender: Object; Args: IEventArgs);
	Var
		Item: MenuItem;
		TaskId, Picked: String;
	Begin
		Item := Null;
		Try
			Item := Sender As MenuItem;
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: пункт меню ответственных — " + e.Message);
			Item := Null;
		End Try;
		If IsNull(Item) Then
			Return;
		End If;
		Picked := String.Trim(Item.Text);
		If Picked = ManualRespCaption Then
			// ручной ввод — открываем форму ведения ответственного (ФИО + почта)
			OpenResponsibleForm(SelectedTaskId);
		Else
			TaskId := SelectedTaskId;
			If TaskId = "" Then
				WinApplication.InformationBox("Выберите задачу в списке");
			Else
				Try
					If ApplyResponsible(TaskId, Picked) Then
						WinApplication.InformationBox("Ответственный для «" + TaskId + "»: " + Picked);
					Else
						WinApplication.InformationBox("Не удалось сохранить ответственного (таблица "
							+ RESP_TABLE_ID + " недоступна или нет прав на запись)");
					End If;
				Except On e: Exception Do
					Debug.WriteLine("Планировщик: запись ответственного из меню — " + e.Message);
					WinApplication.InformationBox("Ошибка записи ответственного: " + e.Message);
				End Try;
			End If;
		End If;
	End Sub RespMenuPickOnClick;

	Sub AnalyseButtonOnClick(Sender: Object; Args: IMouseEventArgs);
	Begin
		If IsNull(CurrentContainers) Or (CurrentContainers.Count = 0) Then
			WinApplication.InformationBox("Сначала выберите контейнеры задач («Выбрать контейнеры…»)");
			Return;
		End If;
		// Анализ раскладки ВСЕХ выбранных контейнеров — ТАБЛИЦЕЙ (грид с заголовками) в окне PLANTEXTForm
		ShowPlanAnalysis(CurrentContainers);
	End Sub AnalyseButtonOnClick;

	Sub ApplyPlanOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Applied: Integer;
	Begin
		If IsNull(CurrentContainers) Or (CurrentContainers.Count = 0) Then
			WinApplication.InformationBox("Сначала выберите контейнеры задач («Выбрать контейнеры…»)");
			Return;
		End If;
		Applied := PlanAndApply(CurrentContainers);
		FillTasksFromContainers(CurrentContainers);
		WinApplication.InformationBox("Расписание применено (контейнеров: "
			+ CurrentContainers.Count.ToString + "). Задач: " + Applied.ToString);
	End Sub ApplyPlanOnClick;

	// Открыть задачу как объект репозитория — то же действие, что даёт ДВОЙНОЙ КЛИК в MetabaseListView
	// (и пункт меню «Редактировать задачу»). Описание берётся из SelectedTaskDescriptor.
	Sub OpenTaskObject(TaskDesc: IMetabaseObjectDescriptor);
	Var
		CommandTarget: IUiCommandTarget;
	Begin
		If IsNull(TaskDesc) Then
			Return;
		End If;
		Try
			CommandTarget := WinApplication.Instance.GetObjectTarget(TaskDesc);
			CommandTarget.Execute("Object.Edit", Null);
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: не удалось открыть задачу «" + TaskDesc.Id + "» — " + e.Message);
			WinApplication.InformationBox("Не удалось открыть задачу «" + TaskDesc.Id + "»: " + e.Message);
		End Try;
	End Sub OpenTaskObject;

	Sub EditButtonOnClick(Sender: Object; Args: IMouseEventArgs);
	Begin
		OpenTaskObject(SelectedTaskDescriptor);   // объединённый список задач или список контейнера
	End Sub EditButtonOnClick;

	// ДВОЙНОЙ КЛИК по строке ОБЪЕДИНЁННОГО списка — открыть задачу (как в списке контейнера).
	// В MetabaseListView это делает сам компонент; у своего ListView поведение задаём кодом — чтобы
	// функционал сохранился и при работе с несколькими контейнерами.
	Sub TaskListMergedOnDblClick(Sender: Object; Args: IMouseEventArgs);
	Var
		List: ListView;
	Begin
		List := Null;
		Try
			List := Sender As ListView;
		Except On e: Exception Do
			List := Null;
		End Try;
		If IsNull(List) Then
			List := TaskListMerged;
		End If;
		OpenTaskObject(TaskRowDescriptor(List));
	End Sub TaskListMergedOnDblClick;

	// === Меню формы («разгрузка»: вместо 28 кнопок — 8 меню) ===
	// Компонента MenuButton в сборке Forms нет, поэтому меню — это обычная Button + компонент PopupMenu:
	// по щелчку строим пункты и показываем меню методом IPopupMenu.Popup. Пункт несёт код действия
	// (Item.Data), а обработчик — MenuActionOnClick. Обработчики-кнопки вызываются с (Null, Null):
	// они не используют Sender/Args (проверено), поэтому логика переиспользуется без дублирования.
	Sub EnsureMenus;
	Begin
		Try
			If IsNull(MenuMore) Then
				MenuMore := New PopupMenu.Create;
			End If;
			If IsNull(MenuUnavail) Then
				MenuUnavail := New PopupMenu.Create;
			End If;
			If IsNull(MenuMark) Then
				MenuMark := New PopupMenu.Create;
			End If;
			If IsNull(MenuDecision) Then
				MenuDecision := New PopupMenu.Create;
			End If;
			If IsNull(MenuPlan) Then
				MenuPlan := New PopupMenu.Create;
			End If;
			If IsNull(MenuExport) Then
				MenuExport := New PopupMenu.Create;
			End If;
			If IsNull(MenuNotify) Then
				MenuNotify := New PopupMenu.Create;
			End If;
			If IsNull(MenuService) Then
				MenuService := New PopupMenu.Create;
			End If;
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: компоненты меню — " + e.Message);
		End Try;
	End Sub EnsureMenus;

	// Пункт меню: подпись + код действия (передаётся в общий MenuActionOnClick)
	Function MenuItemNew(Caption, ActionCode: String; Enabled: Boolean): MenuItem;
	Var
		It: MenuItem;
	Begin
		It := New MenuItem.Create;
		It.Text := Caption;
		It.Data := ActionCode;
		It.Enabled := Enabled;
		If ActionCode <> "" Then
			It.OnClick := MenuActionOnClick;
		End If;
		Return It;
	End Function MenuItemNew;

	Sub MenuShow(Sender: Object; Args: IMouseEventArgs; M: PopupMenu);
	Begin
		If IsNull(M) Then
			Return;
		End If;
		Try
			M.Popup(self, self.Left + (sender As icontrol).Left + args.pPoint.X, self.Top + (sender As icontrol).Top + args.pPoint.Y); // показ у курсора мыши (IPopupMenu.Popup)
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: показ меню — " + e.Message);
			WinApplication.InformationBox("Не удалось показать меню: " + e.Message);
		End Try;
	End Sub MenuShow;

	// --- Наполнение меню (строится перед показом: содержимое всегда актуально) ---
	Sub MenuMoreBuild;
	Var
		HasTask: Boolean;
		Cid: String;
		I: Integer;
	Begin
		If IsNull(MenuMore) Then
			Return;
		End If;
		HasTask := SelectedTaskId <> "";
		MenuMore.Items.Clear;
		MenuMore.Items.Add(MenuItemNew("Редактировать задачу", "task_edit", HasTask));
		MenuMore.Items.Add(MenuItemNew("Ответственный… (ФИО и почта)", "resp_edit", HasTask));
		MenuMore.Items.Add(MenuItemNew("Снять ответственного", "resp_clear", HasTask));
		// Список задач: объединённый по всем выбранным контейнерам — фильтр переключается по кругу
		MenuMore.Items.Add(MenuItemNew("Список задач: фильтр «" + TaskListFilterText + "» → следующий",
			"task_filter_next", (Not IsNull(CurrentContainers)) And (CurrentContainers.Count > 0)));
		// Контейнеры: диалог репозитория «теряет» выделение при переходе по папкам, поэтому набор
		// НАБИРАЕТСЯ за несколько заходов — «Добавить контейнеры…», а также убрать/очистить.
		MenuMore.Items.Add(MenuItemNew("Добавить контейнеры… (из другой папки)", "cont_add", True));
		If (Not IsNull(CurrentContainers)) And (CurrentContainers.Count > 0) Then
			For I := 0 To CurrentContainers.Count - 1 Do
				Cid := (CurrentContainers.Item(I) As IMetabaseObjectDescriptor).Id;
				MenuMore.Items.Add(MenuItemNew("Убрать контейнер «" + Cid + "»", "cont_remove;" + Cid, True));
			End For;
			MenuMore.Items.Add(MenuItemNew("Очистить выбор контейнеров", "cont_clear", True));
		End If;
	End Sub MenuMoreBuild;

	Sub MenuUnavailBuild;
	Begin
		If IsNull(MenuUnavail) Then
			Return;
		End If;
		MenuUnavail.Items.Clear;
		MenuUnavail.Items.Add(MenuItemNew("Ведение недоступностей…", "rec_open", True));
		MenuUnavail.Items.Add(MenuItemNew("Обновить список периодов", "rec_refresh", True));
		MenuUnavail.Items.Add(MenuItemNew("Взять период из записи", "period_take", True));
		MenuUnavail.Items.Add(MenuItemNew("Ручной ввод периода", "period_manual", True));
	End Sub MenuUnavailBuild;

	Sub MenuMarkBuild;
	Begin
		If IsNull(MenuMark) Then
			Return;
		End If;
		MenuMark.Items.Clear;
		MenuMark.Items.Add(MenuItemNew("Обрабатывать все", "mark_all", Not IsNull(UnavailImpacts)));
		MenuMark.Items.Add(MenuItemNew("Не обрабатывать все", "mark_none", Not IsNull(UnavailImpacts)));
	End Sub MenuMarkBuild;

	Sub MenuDecisionBuild;
	Begin
		If IsNull(MenuDecision) Then
			Return;
		End If;
		MenuDecision.Items.Clear;
		MenuDecision.Items.Add(MenuItemNew("Не запускать (все обрабатываемые)", "skip_checked", Not IsNull(UnavailImpacts)));
		MenuDecision.Items.Add(MenuItemNew("Перепланировать (все обрабатываемые)", "resched_checked", Not IsNull(UnavailImpacts)));
		MenuDecision.Items.Add(MenuItemNew("Не запускать (выбранная строка)", "skip_selected", Not IsNull(UnavailImpacts)));
		MenuDecision.Items.Add(MenuItemNew("Перепланировать (выбранная строка)", "resched_selected", Not IsNull(UnavailImpacts)));
		MenuDecision.Items.Add(MenuItemNew("Пересчитать план… (начало, слои, окончание)", "recalc_plan", Not IsNull(UnavailImpacts)));
		MenuDecision.Items.Add(MenuItemNew("Время запуска правится в колонке «Дата нового запуска»", "", False));
	End Sub MenuDecisionBuild;

	Sub MenuPlanBuild;
	Begin
		If IsNull(MenuPlan) Then
			Return;
		End If;
		MenuPlan.Items.Clear;
		MenuPlan.Items.Add(MenuItemNew("Сохранить в таблицу", "plan_save_table", Not IsNull(UnavailImpacts)));
		MenuPlan.Items.Add(MenuItemNew("Загрузить из таблицы", "plan_load_table", UnavailSelectedKey <> 0));
		MenuPlan.Items.Add(MenuItemNew("Показать сохранённый (сравнение)", "plan_show_stored", UnavailSelectedKey <> 0));
		MenuPlan.Items.Add(MenuItemNew("Убрать план", "plan_delete", UnavailSelectedKey <> 0));
		MenuPlan.Items.Add(MenuItemNew("Применить план без простоя", "plan_safe", Not IsNull(UnavailImpacts)));
	End Sub MenuPlanBuild;

	Sub MenuExportBuild;
	Begin
		If IsNull(MenuExport) Then
			Return;
		End If;
		MenuExport.Items.Clear;
		MenuExport.Items.Add(MenuItemNew("План «текстом» в окне (копирование)", "copy_text", True));
	End Sub MenuExportBuild;

	Sub MenuNotifyBuild;
	Begin
		If IsNull(MenuNotify) Then
			Return;
		End If;
		MenuNotify.Items.Clear;
		MenuNotify.Items.Add(MenuItemNew("Разослать уведомления ответственным", "notify_resp",
			(UnavailSelectedKey <> 0) And (Not IsNull(UnavailImpacts))));
		MenuNotify.Items.Add(MenuItemNew("Письма ответственным (сводные, файлы + почта)", "notify_smtp", UnavailSelectedKey <> 0));
	End Sub MenuNotifyBuild;

	Sub MenuServiceBuild;
	Begin
		If IsNull(MenuService) Then
			Return;
		End If;
		MenuService.Items.Clear;
		MenuService.Items.Add(MenuItemNew("Журнал действий", "log", True));
		MenuService.Items.Add(MenuItemNew("Журнал выполненных запусков", "run_log", True));
		MenuService.Items.Add(MenuItemNew("Что будет запущено (сухой прогон)", "dry_run", True));
		MenuService.Items.Add(MenuItemNew("Монитор недоступности", "monitor", True));
	End Sub MenuServiceBuild;

	// Один обработчик на все пункты меню: код действия — в Item.Data
	Sub MenuActionOnClick(Sender: Object; Args: IEventArgs);
	Var
		Item: MenuItem;
		Code: String;
	Begin
		Item := Null;
		Try
			Item := Sender As MenuItem;
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: пункт меню — " + e.Message);
			Item := Null;
		End Try;
		If IsNull(Item) Then
			Return;
		End If;
		Code := UnvVarToStr(Item.Data);
		Try
			MenuActionMain(Code);
			MenuActionPlan(Code);
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: действие меню «" + Code + "» — " + e.Message);
			WinApplication.InformationBox("Не удалось выполнить: " + e.Message);
		End Try;
	End Sub MenuActionOnClick;

	// Действия «задача / ответственный / недоступности / отметки / решения»
	Sub MenuActionMain(Code: String);
	Begin
		If Code = "task_edit" Then
			EditButtonOnClick(Null, Null);
		End If;
		If Code = "resp_edit" Then
			EditResponsibleOnClick(Null, Null);
		End If;
		If Code = "resp_clear" Then
			ClearResponsibleOnClick;
		End If;
		If Code = "rec_open" Then
			OpenRecordsWindowOnClick(Null, Null);
		End If;
		If Code = "rec_refresh" Then
			RefreshUnavailPeriodsOnClick(Null, Null);
		End If;
		If Code = "period_take" Then
			TakeUnavailPeriodOnClick(Null, Null);
		End If;
		If Code = "period_manual" Then
			ManualPeriodOnClick(Null, Null);
		End If;
		If Code = "mark_all" Then
			MarkAllAffectedOnClick(Null, Null);
		End If;
		If Code = "mark_none" Then
			UnmarkAllAffectedOnClick(Null, Null);
		End If;
		If Code = "skip_checked" Then
			SkipCheckedOnClick(Null, Null);
		End If;
		If Code = "resched_checked" Then
			RescheduleCheckedOnClick(Null, Null);
		End If;
		If Code = "skip_selected" Then
			SkipSelectedOnClick(Null, Null);
		End If;
		If Code = "resched_selected" Then
			RescheduleSelectedOnClick(Null, Null);
		End If;
		If Code = "recalc_plan" Then
			RecalcPlanOnClick(Null, Null);
		End If;
		If Code = "task_filter_next" Then
			NextTaskListFilter;
		End If;
		If Code = "cont_add" Then
			AddContainersOnClick(Null, Null);
		End If;
		If Code = "cont_clear" Then
			ClearContainersOnClick;
		End If;
		If Code.Length > 12 Then
			If Code.SubString(0, 12) = "cont_remove;" Then
				RemoveContainerFromSet(Code.SubString(12, Code.Length - 12));
			End If;
		End If;
	End Sub MenuActionMain;

	// Действия «план / выгрузка / уведомления / сервис»

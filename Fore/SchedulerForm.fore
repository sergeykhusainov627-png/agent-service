	// Снять ответственного с выбранной задачи (пункт меню «Снять ответственного»)
	Sub ClearResponsibleOnClick;
	Var
		TaskId: String;
	Begin
		TaskId := SelectedTaskId;
		If TaskId = "" Then
			WinApplication.InformationBox("Сначала выберите задачу в списке задач");
			Return;
		End If;
		ApplyResponsible(TaskId, ""); // пустое ФИО — строка удаляется из RESPONSIBLE_FOR_TASK
		RespIndex_ := LoadResponsibleIndex(RESP_TABLE_ID);
		ShowTaskResponsible(TaskId);
	End Sub ClearResponsibleOnClick;

	// Показать многострочный текст (анализ раскладки / план «текстом») в отдельном окне PLANTEXTForm
	Sub ShowPlanText(Caption, Text: String);
	Var
		F: PLANTEXTForm;
	Begin
		If Text = "" Then
			WinApplication.InformationBox("Текст пуст — нечего показывать");
			Return;
		End If;
		Try
			F := New PLANTEXTForm.CreateForm(Self As IWin32Window);
			F.SendCommand("SetCaption", Caption);
			F.SendCommand("ShowText", Text);
			F.ShowModal;
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: окно текста плана — " + e.Message);
			WinApplication.InformationBox("Не удалось открыть окно текста: " + e.Message);
		End Try;
	End Sub ShowPlanText;

	// Анализ раскладки ВЫБРАННЫХ контейнеров — ТАБЛИЦЕЙ в окне PLANTEXTForm (грид с заголовками).
	// Окну передаются Id контейнеров одной строкой («A;B;C»): саму таблицу оно строит вызовом
	// BuildPlanInfosForContainers (TaskPlanner.fore), поэтому между формами не передаются объекты.
	Sub ShowPlanAnalysis(Containers: ArrayList);
	Var
		F: PLANTEXTForm;
	Begin
		If IsNull(Containers) Or (Containers.Count = 0) Then
			Return;
		End If;
		Try
			F := New PLANTEXTForm.CreateForm(Self As IWin32Window);
			F.SendCommand("SetCaption", "Анализ раскладки: контейнеров " + Containers.Count.ToString
				+ " (" + ContainersText(Containers) + ")");
			F.SendCommand("ShowAnalysis", ContainersIdsText(Containers));
			F.ShowModal;                                        // закрывается крестиком окна
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: окно анализа раскладки — " + e.Message);
			WinApplication.InformationBox("Не удалось открыть окно анализа раскладки: " + e.Message);
		End Try;
	End Sub ShowPlanAnalysis;

	// «План «текстом» в окне» (меню «Выгрузка ▾»): текст строится по ВСЕМ выбранным контейнерам
	Sub ShowPlanTextOnClick;
	Begin
		If IsNull(CurrentContainers) Or (CurrentContainers.Count = 0) Then
			WinApplication.InformationBox("Сначала выберите контейнеры задач («Выбрать контейнеры…»)");
			Return;
		End If;
		Try
			ShowPlanText("План раскладки «текстом» (можно скопировать)", PlanText(CurrentContainers));
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: план текстом — " + e.Message);
			WinApplication.InformationBox("Не удалось построить текст плана: " + e.Message);
		End Try;
	End Sub ShowPlanTextOnClick;

	// Строка статуса блока «Затронутые задачи» (вместо многострочной сводки в Memo)
	Sub UpdateStatusLine;
	Var
		Impact: CUnavailImpact;
		Total, Skip, Resched, Processed, I: Integer;
	Begin
		If IsNull(LblStatus) Then
			Return;
		End If;
		If IsNull(UnavailImpacts) Then
			LblStatus.Text := "Список пересекающихся задач не построен";
			Return;
		End If;
		Total := 0;
		Skip := 0;
		Resched := 0;
		Processed := 0;
		For I := 0 To UnavailImpacts.Count - 1 Do
			Impact := UnavailImpacts.Item(I) As CUnavailImpact;
			Total := Total + 1;
			If ImpactProcessed(Impact) Then
				Processed := Processed + 1;
			End If;
			If Impact.Decision = DECISION_SKIP Then
				Skip := Skip + 1;
			End If;
			If Impact.Decision = DECISION_RESCHEDULE Then
				Resched := Resched + 1;
			End If;
		End For;
		LblStatus.Text := "Пересекается задач: " + Total.ToString
			+ " (обрабатывать: " + Processed.ToString + " — перепланировать: " + Resched.ToString
			+ ", не запускать: " + Skip.ToString + "; без обработки: " + (Total - Processed).ToString + ")";
	End Sub UpdateStatusLine;

	Sub PlannerPlace(C: IControl; L, T, W, H: Integer);
	Begin
		C.Left := Double.RoundInt(L * LayoutK);
		C.Top := Double.RoundInt((T - LAYOUT_TOP_SHIFT) * LayoutK);   // компоновка поднята вверх
		C.Width := Double.RoundInt(W * LayoutK);
		C.Height := Double.RoundInt(H * LayoutK);
	End Sub PlannerPlace;

	Sub SetupPlannerLayout;
	Var
		Ctl: Button;
		Gr: GroupBox;
	Begin
		Self.Width := Double.RoundInt((1780 + PANEL_X_SHIFT + PANEL_X_GROW) * LayoutK);
		Self.Height := Double.RoundInt(1300 * LayoutK);

		// Списки репозитория обязаны быть размещены на форме ЗАРАНЕЕ (динамически MetabaseListView
		// не создаём — на стенде это приводило к падению приложения), поэтому работаем только
		// с существующими контролами.
		If Not IsNull(MetabaseListView2) Then
			// Список задач — внутри рамки блока «Задачи контейнера» (GrpTasks: 26;354;756;282)
			PlannerPlace(MetabaseListView2, 38, 376, 732, 560);   // список задач вырос: вместо сводки плана (PLANTEXTForm)

			// Табличный вид списка задач: Style = Report — перечисление ListViewStyle
			// (сборка Forms): Icon / SmallIcon / List / Report («таблица»).
			MetabaseListView2.Style := ListViewStyle.Report;
			MetabaseListView2.GridLines := True;
			MetabaseListView2.RowSelect := True;
			MetabaseListView2.ShowColumnHeaders := True;

			// Колонки списка задач (IListViewColumns) + AutoSize и выравнивание
			SetupTaskListColumns(MetabaseListView2);

			// Клик по строке списка → карточка задачи. Обработчик привязываем КОДОМ (в дизайнере
			// привязка не нужна): MetabaseListView2OnClick — существующий обработчик формы.
			MetabaseListView2.OnClick := MetabaseListView2OnClick;
		End If;

		// ОБЪЕДИНЁННЫЙ список задач по нескольким контейнерам — на том же месте, что список контейнера
		// (показывается, когда контейнеры выбраны; MetabaseListView2 остаётся запасным вариантом).
		If Not IsNull(TaskListMerged) Then
			PlannerPlace(TaskListMerged, 38, 376, 732, 560);
			SetupMergedTaskList(TaskListMerged);
			TaskListMerged.OnClick := TaskListMergedOnClick;   // клик по строке — карточка задачи
			TaskListMerged.OnDblClick := TaskListMergedOnDblClick; // двойной клик — открыть задачу
			TaskListMerged.Visible := False;
		End If;
		// Автомасштаб при изменении размеров окна (константа UI_AUTOSIZE_ON_RESIZE в TaskContainerLib):
		// списку задач — тянуться по ширине, кнопкам действий — держаться за нижний край окна.
		// ⚠ SetAutoSize вызывает только для СУЩЕСТВУЮЩИХ контролов: кнопки, заменённые меню
		// (BtnEditTask и т. д.), из формы удалены — упоминание их имён не компилируется.
		SetAutoSize(MetabaseListView2, True, False);
		If Not IsNull(TaskListMerged) Then
			SetAutoSize(TaskListMerged, True, False);
		End If;
		SetAutoSize(BtnAnalyse, False, True);
		SetAutoSize(BtnApplyPlan, False, True);

		// Рамки блоков левой колонки (создаёт фабрика по строкам GROUP в ScreenSpecText).
		// У контролов внутри блока Anchors считаются от клиентской области группы, а не от окна.
		AnchorGroup("GrpTaskCard", True, False);
		AnchorGroup("GrpTasks", True, False);

		// Кнопка с меню ответственных: MenuButton (Forms) — свойство Menu := PopupMenu.
		// ⚠ Со стенда: кнопка НЕ нажималась, пока лежала на форме соседом рамки GROUP — в Fore
		// надёжно работает только «ребёнок контейнера» (так сделаны остальные контролы блока
		// и списки — см. PlaceInGroup). Поэтому кнопка делается ребёнком GrpTaskCard: рамка её
		// не закрывает, и она едет вместе с блоком.
		If (Not IsNull(RespMenuButton)) And (Not IsNull(RespPopupMenu)) Then
			Try
				RespMenuButton.Text := "Ранее использованные ответственные ▾";
				RespMenuButton.Menu := RespPopupMenu;                     // IMenuButton.Menu: IPopupMenu
				Gr := UiFind(Map_, "GrpTaskCard") As GroupBox;
				If Not IsNull(Gr) Then
					RespMenuButton.Parent := Gr;
					RespMenuButton.Left := Double.RoundInt(250 * LayoutK);          // 276 - 26 (левый край группы)
					RespMenuButton.Top := Double.RoundInt((198 - GROUP_CAPTION) * LayoutK); // 308 - 110 - подпись
					RespMenuButton.Width := Double.RoundInt(300 * LayoutK);
					RespMenuButton.Height := Double.RoundInt(28 * LayoutK);
				Else
					PlannerPlace(RespMenuButton, 276, 308, 300, 28);     // блок не создан — как раньше
				End If;
				RespMenuButton.OnClick := RespMenuButtonOnClick;          // страховка, если Menu не всплывёт
				RespMenuBuild;
			Except On e: Exception Do
				Debug.WriteLine("Планировщик: меню ответственных — " + e.Message);
			End Try;
		End If;

		// Компоненты меню (пункты строятся перед показом — см. MenuShow/MenuXxxBuild).
		// Компонента MenuButton в сборке Forms нет: меню показывает Button методом Popup).
		EnsureMenus;
		// Кнопки-меню: подписываем явно (обработчик нельзя передать параметром — только присвоить)
		Ctl := UiFind(Map_, "BtnMenuMore") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := MenuMoreOnClick;
		End If;
		Ctl := UiFind(Map_, "BtnMenuUnavail") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := MenuUnavailOnClick;
		End If;
		Ctl := UiFind(Map_, "BtnMenuNotify") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := MenuNotifyOnClick;
		End If;
		Ctl := UiFind(Map_, "BtnMenuMark") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := MenuMarkOnClick;
		End If;
		Ctl := UiFind(Map_, "BtnMenuDecision") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := MenuDecisionOnClick;
		End If;
		Ctl := UiFind(Map_, "BtnMenuPlan") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := MenuPlanOnClick;
		End If;
		Ctl := UiFind(Map_, "BtnMenuExport") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := MenuExportOnClick;
		End If;
		Ctl := UiFind(Map_, "BtnMenuService") As Button;
		If Not IsNull(Ctl) Then
			Ctl.OnClick := MenuServiceOnClick;
		End If;
	End Sub SetupPlannerLayout;

	Sub OpenUnavailabilityOnClick(Sender: Object; Args: IMouseEventArgs);
	Begin
		If ContainersCount(CurrentContainers) = 0 Then
			WinApplication.InformationBox("Сначала выберите контейнеры задач («Выбрать контейнеры…»)");
			Return;
		End If;
		// Список задач контейнера ведёт сама форма (MetabaseListView2, левая колонка);
		// таблица плана показывает ВСЕ задачи, пересекающиеся с периодом (блок «Раскладка (план)»).
		UnavailImpacts := New ArrayList.Create;
		UnavailWindow := New CUnavailWindow.Create;
		// ⚠ Выбор записи недоступности здесь НЕ сбрасываем: иначе после «Взять период» → «Построить
		// список» терялась выбранная запись (UnavailSelectedKey = 0), и «Сохранить в таблицу» просил
		// выбрать запись заново. Сбрасывает выбор только «Ручной ввод периода».
		// Пикеры уже настроены один раз в FormOnCreate (ConfigurePeriodPickers): здесь их вид
		// подтверждаем повторно (идемпотентно, только Kind/Format — значения не сбрасываются), чтобы
		// период точно попал в пикеры, даже если на стенде не привязан OnCreate.
		ConfigurePeriodPickers;
		FillUnavailPeriods;                      // список периодов недоступности из таблицы
		UnavailSummaryMemo.Lines.Clear;
		UnavailSummaryMemo.Lines.Add("Задайте период недоступности и нажмите «Построить список».");
	End Sub OpenUnavailabilityOnClick;

	Sub BuildAffectedOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Rec: CUnavailRecord;
	Begin
		OpenUnavailabilityOnClick(Sender, Args);
		If ContainersCount(CurrentContainers) = 0 Then
			WinApplication.InformationBox("Сначала выберите контейнеры задач («Выбрать контейнеры…»)");
			Return;
		End If;
		// Если период взят из записи («Взять период») — вернём его в пикеры: настройка вида пикеров
		// не должна «съедать» значения, а сам выбор записи не сбрасывается (см. v1.88).
		Rec := FindUnavailRecord(UnavailRecords, UnavailSelectedKey);
		If Not IsNull(Rec) Then
			SetPeriodPickers(Rec.StartDt, Rec.EndDt);
		End If;
		UnavailWindow := New CUnavailWindow.Create;
		UnavailWindow.Start := ComposeDateAndTime(UnavailStartDatePicker.CurrentDate, UnavailStartTimePicker.CurrentDate);
		UnavailWindow.Stop := ComposeDateAndTime(UnavailEndDatePicker.CurrentDate, UnavailEndTimePicker.CurrentDate);
		UnavailWindow.TailHours := DEFAULT_TAIL_HOURS;

		UnavailImpacts := PrepareUnavailabilityPlan(CurrentContainers,
			UnavailWindow.Start, UnavailWindow.Stop, UnavailWindow.TailHours);
		// Все пересекающиеся задачи по умолчанию «обрабатывать» + «перепланировать» (см. CollectAffectedTasks)
		RenderUnavailSummary;
	End Sub BuildAffectedOnClick;

	// (пункт «Отметить затронутые» убран: все пересекающиеся задачи и так «обрабатывать» по умолчанию)

	Sub SkipCheckedOnClick(Sender: Object; Args: IMouseEventArgs);
	Begin
		ApplyProcessed(DECISION_SKIP);
		RenderUnavailSummary;
	End Sub SkipCheckedOnClick;

	Sub RescheduleCheckedOnClick(Sender: Object; Args: IMouseEventArgs);
	Begin
		ApplyProcessed(DECISION_RESCHEDULE);
		RenderUnavailSummary;
	End Sub RescheduleCheckedOnClick;

	Sub SkipSelectedOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Impact: CUnavailImpact;
	Begin
		Impact := SelectedUnavailImpact;
		If IsNull(Impact) Then
			WinApplication.InformationBox("Выберите задачу из списка (она должна попадать в период)");
			Return;
		End If;
		Impact.Decision := DECISION_SKIP;
		RenderUnavailSummary;
	End Sub SkipSelectedOnClick;

	Sub RescheduleSelectedOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Impact: CUnavailImpact;
	Begin
		Impact := SelectedUnavailImpact;
		If IsNull(Impact) Then
			WinApplication.InformationBox("Выберите задачу из списка (она должна попадать в период)");
			Return;
		End If;
		Impact.Decision := DECISION_RESCHEDULE;
		RenderUnavailSummary;
	End Sub RescheduleSelectedOnClick;

	Sub RefreshUnavailPeriodsOnClick(Sender: Object; Args: IMouseEventArgs);
	Begin
		FillUnavailPeriods;
	End Sub RefreshUnavailPeriodsOnClick;

	Sub TakeUnavailPeriodOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Rec: CUnavailRecord;
	Begin
		Rec := FindUnavailRecord(UnavailRecords, SelectedUnavailPeriodKey);
		If IsNull(Rec) Then
			WinApplication.InformationBox("Выберите запись о недоступности в списке");
			Return;
		End If;
		UnavailSelectedKey := Rec.Key;
		SetPeriodPickers(Rec.StartDt, Rec.EndDt);
		UnavailStartDatePicker.Enabled := False;   // период берём из таблицы, а не правим вручную
		UnavailStartTimePicker.Enabled := False;
		UnavailEndDatePicker.Enabled := False;
		UnavailEndTimePicker.Enabled := False;
	End Sub TakeUnavailPeriodOnClick;

	Sub ManualPeriodOnClick(Sender: Object; Args: IMouseEventArgs);
	Begin
		UnavailStartDatePicker.Enabled := True;
		UnavailStartTimePicker.Enabled := True;
		UnavailEndDatePicker.Enabled := True;
		UnavailEndTimePicker.Enabled := True;
		UnavailSelectedKey := 0;
		SelectUnavailPeriodRow(0);             // в ручном режиме запись не выбрана — снимаем выделение
	End Sub ManualPeriodOnClick;

	Sub OpenRecordsWindowOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		F: Form;
	Begin
		F := New UNAVAILABILITYRECORDSForm.CreateForm(Self As IWin32Window);
		F.ShowModal;
		FillUnavailPeriods;                       // после закрытия окна — перечитать список
	End Sub OpenRecordsWindowOnClick;

	Sub SavePlanToTableOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Saved: Integer;
	Begin
		If UnavailSelectedKey = 0 Then
			WinApplication.InformationBox("Сначала выберите запись о недоступности и возьмите из неё период");
			Return;
		End If;
		If IsNull(UnavailImpacts) Then
			WinApplication.InformationBox("Сначала постройте список затронутых задач");
			Return;
		End If;
		Saved := SavePlanToTable(UnavailSelectedKey, UnavailImpacts);
		If Saved = 0 Then
			WinApplication.InformationBox("Не удалось сохранить план в таблицу");
			Return;
		End If;
		WinApplication.InformationBox("План сохранён в таблицу. Строк: " + Saved.ToString
			+ UNAVAIL_CRLF + PlanRunsSummaryText(UnavailSelectedKey));
	End Sub SavePlanToTableOnClick;

	Sub LoadPlanFromTableOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Applied: Integer;
	Begin
		If UnavailSelectedKey = 0 Then
			WinApplication.InformationBox("Сначала выберите запись о недоступности и возьмите из неё период");
			Return;
		End If;
		If IsNull(UnavailImpacts) Then
			WinApplication.InformationBox("Сначала постройте список затронутых задач");
			Return;
		End If;
		Applied := ApplyStoredPlanToImpacts(UnavailSelectedKey, UnavailImpacts);
		RenderUnavailSummary;
		WinApplication.InformationBox(ApplyStoredPlanReport(UnavailSelectedKey, UnavailImpacts));
	End Sub LoadPlanFromTableOnClick;

	Sub ShowStoredPlanOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Rows: ArrayList;
		Row: CUnavailStoredPlanRow;
		Item: IListViewItem;
		Done, I: Integer;
	Begin
		If UnavailSelectedKey = 0 Then
			WinApplication.InformationBox("Сначала выберите запись о недоступности");
			Return;
		End If;
		StoredPlanTable.Items.Clear;
		Rows := LoadStoredPlanRows(UnavailSelectedKey);
		Done := 0;
		StoredPlanTable.Items.BeginUpdate;
		For I := 0 To Rows.Count - 1 Do
			Row := Rows.Item(I) As CUnavailStoredPlanRow;
			StoredPlanTable.Items.Add(Row.TaskId);
			Item := StoredPlanTable.Items.Item(StoredPlanTable.Items.Count - 1);
			Item.ColumnText(1) := Row.TaskName;
			Item.ColumnText(2) := Row.BaName;
			Item.ColumnText(3) := Row.ResponsibleUser;
			Item.ColumnText(4) := Row.StartOriginal.ToString;
			Item.ColumnText(5) := Row.EndOriginal.ToString;
			Item.ColumnText(6) := Row.SpanText;
			If Row.HasNewStart Then
				Item.ColumnText(7) := Row.NewStart.ToString;
			End If;
			If Row.HasDoneAt Then
				Done := Done + 1;
			End If;
		End For;
		StoredPlanTable.Items.EndUpdate;
		SetMemoLines(UnavailSummaryMemo, "Сохранённый план по выбранной недоступности: строк "
			+ Rows.Count.ToString + ", из них выполнено " + Done.ToString + "."
			+ UNAVAIL_CRLF + PlanRunsSummaryText(UnavailSelectedKey));
	End Sub ShowStoredPlanOnClick;

	Sub DeletePlanOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Msg: String;
	Begin
		If UnavailSelectedKey = 0 Then
			WinApplication.InformationBox("Сначала выберите запись о недоступности и возьмите из неё период");
			Return;
		End If;
		Msg := "Убрать сохранённый план по записи " + UnavailSelectedKey.ToString
			+ "? Диспетчер больше не будет её выполнять.";
		If Not WinApplication.ConfirmationBox(Msg) Then
			Return;
		End If;
		If DeleteStoredPlan(UnavailSelectedKey) Then
			StoredPlanTable.Items.Clear;
			UnavailSummaryMemo.Lines.Clear;
			UnavailSummaryMemo.Lines.Add("План по записи " + UnavailSelectedKey.ToString + " удалён.");
			FillUnavailPeriods;
		Else
			WinApplication.InformationBox("Не удалось удалить план (нет прав или таблица недоступна)");
		End If;
	End Sub DeletePlanOnClick;

	Sub DryRunOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Rows: ArrayList;
		Row: CUnavailStoredRun;
		S: String;
		I: Integer;
	Begin
		If ContainersCount(CurrentContainers) = 0 Then
			WinApplication.InformationBox("Сначала выберите контейнеры задач на форме «Планировщик»");
			Return;
		End If;
		S := UnavailRunTickReport(CurrentContainer, DEFAULT_TAIL_HOURS);
		Rows := LoadAttentionRunRows(24, 500);
		If Rows.Count > 0 Then
			S := S + UNAVAIL_CRLF + UNAVAIL_CRLF + "Требуют внимания (" + Rows.Count.ToString + "):";
			For I := 0 To Rows.Count - 1 Do
				Row := Rows.Item(I) As CUnavailStoredRun;
				S := S + UNAVAIL_CRLF + Row.NewStart.ToString + " — " + Row.TaskId
					+ " (" + UnavailRunStateText(Row.RunState) + ", попыток " + Row.Attempts.ToString
					+ ", запись " + Row.Key.ToString + ")";
				If Row.ErrorText <> "" Then
					S := S + " " + Row.ErrorText;
				End If;
			End For;
		End If;
		SetMemoLines(UnavailSummaryMemo, S);
	End Sub DryRunOnClick;

	Sub ShowLogOnClick(Sender: Object; Args: IMouseEventArgs);
	Begin
		SetMemoLines(UnavailSummaryMemo, UnavailLogText(UnavailSelectedKey, 200));
	End Sub ShowLogOnClick;

	// Журнал ВЫПОЛНЕННЫХ запусков диспетчера (таблица UNAVAILABILITY_RUN_LOG): попытки по выбранной
	// записи недоступности, а если запись не выбрана (0) — по всем записям.
	Sub ShowRunLogOnClick(Sender: Object; Args: IMouseEventArgs);
	Begin
		SetMemoLines(UnavailSummaryMemo, RunLogText(UnavailSelectedKey, 200));
	End Sub ShowRunLogOnClick;

	Sub ApplyPlanAvoidingOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Windows: ArrayList;
		Applied: Integer;
		Msg: String;
	Begin
		If ContainersCount(CurrentContainers) = 0 Then
			WinApplication.InformationBox("Сначала выберите контейнеры задач на форме «Планировщик»");
			Return;
		End If;
		Windows := BuildForbiddenWindows;
		Msg := "Построить и ПРИМЕНИТЬ план планировщика с учётом " + Windows.Count.ToString
			+ " окна(окон) недоступности? Расписание задач будет перезаписано.";
		If Not WinApplication.ConfirmationBox(Msg) Then
			Return;
		End If;
		Applied := PlanAndApplyAvoiding(CurrentContainers, Windows);
		WinApplication.InformationBox("План применён. Задач перенастроено: " + Applied.ToString + "."
			+ UNAVAIL_CRLF + UNAVAIL_CRLF + PlanTextAvoiding(CurrentContainers, Windows));
	End Sub ApplyPlanAvoidingOnClick;

	Sub MarkAllAffectedOnClick(Sender: Object; Args: IMouseEventArgs);
	Begin
		SetAllProcessed(True);
		RenderUnavailSummary;
	End Sub MarkAllAffectedOnClick;

	Sub UnmarkAllAffectedOnClick(Sender: Object; Args: IMouseEventArgs);
	Begin
		SetAllProcessed(False);
		RenderUnavailSummary;
	End Sub UnmarkAllAffectedOnClick;

	Sub ApplyFilterOnClick(Sender: Object; Args: IMouseEventArgs);
	Begin
		TableFilter := FilterEditBox.Text;
		FillPlanTable;
		If IsNull(UnavailImpacts) Then
			SetMemoLines(UnavailSummaryMemo, "Фильтр: «" + TableFilter + "» — план ещё не построен.");
			Return;
		End If;
		SetMemoLines(UnavailSummaryMemo, "Фильтр: «" + TableFilter + "» — строк в таблице "
			+ PlanTable.Items.Count.ToString + " из " + UnavailImpacts.Count.ToString + "."
			+ UNAVAIL_CRLF + UnavailPlanHeaderText(UnavailImpacts, UnavailWindow));
	End Sub ApplyFilterOnClick;

	Sub ResetFilterOnClick(Sender: Object; Args: IMouseEventArgs);
	Begin
		TableFilter := "";
		FilterEditBox.Text := "";
		RenderUnavailSummary;
	End Sub ResetFilterOnClick;

	Sub NotifyOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Notices: ArrayList;
		Saved, Sent: Integer;
		S, Msg: String;
	Begin
		If IsNull(UnavailImpacts) Then
			WinApplication.InformationBox("Сначала постройте список затронутых задач");
			Return;
		End If;
		Notices := NoticesFromImpacts(UnavailImpacts, UnavailWindow);
		S := UnavailNoticesText(Notices);
		Saved := SaveNoticesToFolder(Notices, NOTIFY_FOLDER);
		S := S + UNAVAIL_CRLF + "Файлов писем сохранено (" + NOTIFY_FOLDER + "): " + Saved.ToString + ".";
		// Отправка — функцией заказчика SendMailMessage(To_; From_; Subject; Body) (SMTP-функция удалена)
		Sent := 0;
		Msg := "Отправить " + Notices.Count.ToString + " письмо(писем) ответственным?";
		If WinApplication.ConfirmationBox(Msg) Then
			Sent := SendNoticesUserMailer(Notices, NOTIFY_FROM);
		End If;
		S := S + UNAVAIL_CRLF + "Писем отправлено: " + Sent.ToString + ".";
		SetMemoLines(UnavailSummaryMemo, S);
	End Sub NotifyOnClick;

	// Выбранная запись о недоступности (сроки + автор) из списка периодов
	Function CurrentUnavailRecord: CUnavailRecord;
	Var
		I: Integer;
	Begin
		If IsNull(UnavailRecords) Or IsNull(UnavailRecordKeys) Then
			Return Null;
		End If;
		If UnavailSelectedKey <= 0 Then
			Return Null;
		End If;
		For I := 0 To UnavailRecordKeys.Count - 1 Do
			If (UnavailRecordKeys.Item(I) As Integer) = UnavailSelectedKey Then
				If I < UnavailRecords.Count Then
					Return UnavailRecords.Item(I) As CUnavailRecord;
				End If;
			End If;
		End For;
		Return Null;
	End Function CurrentUnavailRecord;

	// «Разослать уведомление ответственным»: сроки недоступности + автор записи + список задач
	// ответственного. Адрес берётся из колонки MAIL таблицы ответственных, отправка — своей функцией
	// проекта SendMailMessage(To; From; Subject; Body) (UnavailNotify.SendNoticesUserMailer).
	Sub NotifyResponsiblesOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Rec: CUnavailRecord;
		Notices, Problems: ArrayList;
		Sent: Integer;
		Msg, S: String;
	Begin
		If IsNull(UnavailImpacts) Then
			WinApplication.InformationBox("Сначала постройте список затронутых задач («Построить список»)");
			Return;
		End If;
		Rec := CurrentUnavailRecord;
		If IsNull(Rec) Then
			WinApplication.InformationBox("Выберите запись о недоступности в списке периодов");
			Return;
		End If;
		Problems := New ArrayList.Create;
		Notices := NoticesForResponsibles(UnavailImpacts, RespIndex_, Rec.StartDt, Rec.EndDt,
			Rec.Author, Problems);
		S := UnavailNoticesForSendText(Notices, Problems);
		SetMemoLines(UnavailSummaryMemo, S);
		If Notices.Count = 0 Then
			WinApplication.InformationBox("Уведомления не отправлены — подробности в сводке на форме.");
			Return;
		End If;
		Msg := "Отправить уведомления (" + Notices.Count.ToString + " шт.) ответственным по адресам "
			+ "из колонки MAIL?" + UNAVAIL_CRLF + UNAVAIL_CRLF + S;
		If Not WinApplication.ConfirmationBox(Msg) Then
			Return;
		End If;
		Sent := SendNoticesUserMailer(Notices, NOTIFY_FROM);
		SetMemoLines(UnavailSummaryMemo, "Разослано уведомлений: " + Sent.ToString + " из "
			+ Notices.Count.ToString + UNAVAIL_CRLF + UNAVAIL_CRLF + S);
		WinApplication.InformationBox("Писем отправлено: " + Sent.ToString + " из "
			+ Notices.Count.ToString + ".");
	End Sub NotifyResponsiblesOnClick;

	Sub MonitorOnClick(Sender: Object; Args: IMouseEventArgs);
	Begin
		SetMemoLines(UnavailSummaryMemo, UnavailMonitorText);
	End Sub MonitorOnClick;

	Sub PanelPlace(C: IControl; L, T, W, H: Integer);
	Begin
		C.Left := Double.RoundInt((L + PANEL_X_SHIFT) * LayoutK);
		C.Top := Double.RoundInt((T - LAYOUT_TOP_SHIFT) * LayoutK);
		C.Width := Double.RoundInt((W + PANEL_X_GROW) * LayoutK);
		C.Height := Double.RoundInt(H * LayoutK);
	End Sub PanelPlace;

	// Поместить контрол ВНУТРЬ блока: Parent := группа — ребёнок всегда рисуется ПОВЕРХ рамки.
	// Без этого GROUP, созданная фабрикой позже (а списки репозитория размещены в дизайнере заранее),
	// закрывает список — симптом «периоды недоступности не работают, их что-то перекрыло».
	// RelL/RelT — от верхнего левого угла ГРУППЫ (единицы макета); внутри клиентской области
	// координата уменьшается на высоту подписи GroupBox (GROUP_CAPTION).
	Sub PlaceInGroup(C: IControl; GroupName: String; RelL, RelT, W, H: Integer);
	Var
		Gr: GroupBox;
	Begin
		If IsNull(C) Then
			Return;
		End If;
		Gr := UiFind(Map_, GroupName) As GroupBox;
		If IsNull(Gr) Then
			PanelPlace(C, RelL, RelT, W, H);            // блока нет — обычное размещение
			Return;
		End If;
		C.Parent := Gr;
		C.Left := Double.RoundInt(RelL * LayoutK);
		C.Top := Double.RoundInt((RelT - GROUP_CAPTION) * LayoutK);
		C.Width := Double.RoundInt((W + PANEL_X_GROW) * LayoutK);
		C.Height := Double.RoundInt(H * LayoutK);
	End Sub PlaceInGroup;

	// Автомасштаб рамки блока: группы (GROUP в описании экрана) создаёт фабрика, поэтому
	// поля формы для них не объявляются — находим по имени в карте и настраиваем края.
	Sub AnchorGroup(Name: String; StretchRight, StretchBottom: Boolean);
	Var
		Gr: GroupBox;
	Begin
		If IsNull(Map_) Or Not UI_AUTOSIZE_ON_RESIZE Then
			Return;
		End If;
		Try
			Gr := UiFind(Map_, Name) As GroupBox;
			If Not IsNull(Gr) Then
				SetAutoSize(Gr, StretchRight, StretchBottom);
			End If;
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: автомасштаб блока " + Name + " — " + e.Message);
		End Try;
	End Sub AnchorGroup;

	// Табличный (колоночный) вид списка: Style = Report. Перечисление ListViewStyle
	// (сборка Forms): 0 Icon — крупные пиктограммы, 1 SmallIcon — мелкие,
	// 2 List — список пиктограмм, 3 Report — таблица. Без Report список рисует значки.
	Sub SetupPanelList(LV: ListView);
	Begin
		Try
			LV.Style := ListViewStyle.Report;
			LV.GridLines := True;            // сетка между строками и столбцами
			LV.RowSelect := True;            // выделять строку целиком
			LV.ShowColumnHeaders := True;    // заголовки столбцов
			LV.ReadOnly := True;             // текст ячеек не редактируется
		Except On e: Exception Do
			Debug.WriteLine("Недоступность: настройка списка — " + e.Message);
		End Try;
	End Sub SetupPanelList;

	// Выравнивание колонок таблицы плана (перечисление TextAlignment: Left / Center / Right):
	// текстовые — влево, даты и длительность — по центру.
	Function PlanColumnAlign(ColIdx: Integer): TextAlignment;
	Begin
		If ColIdx = UNAVAIL_COL_START_TIME Then
			Return TextAlignment.Center;
		End If;
		If ColIdx = UNAVAIL_COL_END_TIME Then
			Return TextAlignment.Center;
		End If;
		If ColIdx = UNAVAIL_COL_TIME_SPAN Then
			Return TextAlignment.Center;
		End If;
		If ColIdx = UNAVAIL_COL_START_TIME_NEW Then
			Return TextAlignment.Center;
		End If;
		Return TextAlignment.Left;
	End Function PlanColumnAlign;

	// Колонки таблицы плана — создаются кодом только если их ещё нет (Columns.Count = 0),
	// поэтому в Инспекторе колонки можно задать вручную и код ничего не переопределит.
	// Каждая колонка настраивается через SetListColumn (TaskContainerLib): подпись, ширина,
	// «резиновость» (AutoSize) и выравнивание (TextAlignment). Тянется название задачи.
	Sub SetupPlanTableColumns(LV: ListView);
	Var
		Col: IListViewColumn;
		ColIdx: Integer;
	Begin
		Try
			If (LV.Columns.Count = 0) Or (LV.Columns.Count <> UNAVAIL_PLAN_COLUMNS) Then
				// Набор колонок изменился (в 1.86 добавлены «Обрабатывать» и «Не запускать») —
				// пересоздаём, чтобы новые столбцы появились и на стенде, где колонки заданы ранее.
				LV.Columns.Clear;
				For ColIdx := 0 To UNAVAIL_PLAN_COLUMNS - 1 Do
					Col := LV.Columns.Add;
					SetListColumn(Col, UnavailPlanColumnCaption(ColIdx), UnavailPlanColumnWidth(ColIdx),
						ColIdx = UNAVAIL_COL_TASK_NAME, PlanColumnAlign(ColIdx));
				End For;
			Else
				SetColumnsAutoSize(LV.Columns);      // колонки задал Инспектор — включаем авторазмер
			End If;
		Except On e: Exception Do
			Debug.WriteLine("Недоступность: колонки таблицы плана — " + e.Message);
		End Try;
	End Sub SetupPlanTableColumns;

	// Колонки списка периодов недоступности (5): начало, окончание, автор, изменение, план.
	// SetListColumn: подпись, ширина, «резиновость» и выравнивание; тянется «Автор»
	// (даты и признак плана — по центру).
	Sub SetupRecordsListColumns(LV: ListView);
	Var
		Col: IListViewColumn;
	Begin
		Try
			If LV.Columns.Count = 0 Then
				Col := LV.Columns.Add;
				SetListColumn(Col, "Начало", 150, False, TextAlignment.Center);
				Col := LV.Columns.Add;
				SetListColumn(Col, "Окончание", 150, False, TextAlignment.Center);
				Col := LV.Columns.Add;
				SetListColumn(Col, "Автор", 220, True, TextAlignment.Left);
				Col := LV.Columns.Add;
				SetListColumn(Col, "Изменено", 150, False, TextAlignment.Center);
				Col := LV.Columns.Add;
				SetListColumn(Col, "План", 90, False, TextAlignment.Center);
			Else
				SetColumnsAutoSize(LV.Columns);
			End If;
		Except On e: Exception Do
			Debug.WriteLine("Недоступность: колонки списка периодов — " + e.Message);
		End Try;
	End Sub SetupRecordsListColumns;

	// Колонки списка задач контейнера (MetabaseListView — тоже IListView, поэтому IListViewColumns).
	// Значения строк даёт сам компонент (Root — контейнер задач): из кода доступны подпись, ширина,
	// выравнивание и авторазмер, свойства привязки колонки к атрибуту объекта в API нет — если на
	// стенде колонки заданы в Инспекторе («Редактор колонок», атрибут + подпись), код их не трогает.
	Sub SetupTaskListColumns(LV: MetabaseListView);
	Var
		Col: IListViewColumn;
	Begin
		Try
			If LV.Columns.Count = 0 Then
				Col := LV.Columns.Add;
				SetListColumn(Col, "Задача", 260, True, TextAlignment.Left);
				Col := LV.Columns.Add;
				SetListColumn(Col, "Тип", 120, False, TextAlignment.Left);
				Col := LV.Columns.Add;
				SetListColumn(Col, "Состояние", 130, False, TextAlignment.Left);
			Else
				SetColumnsAutoSize(LV.Columns);
			End If;
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: колонки списка задач — " + e.Message);
		End Try;
	End Sub SetupTaskListColumns;

	// Колонки списка затронутых задач убраны вместе с самим списком (1.86): роль «кто обрабатывается»
	// выполняет таблица плана — колонки «Обрабатывать» / «Не запускать» (см. UnavailabilityPlanner).

	// Колонки дерева задач (MetabaseTreeList → ITreeControl: коллекция СВОЯ, ITreeListColumns,
	// элементы — ITreeListColumn; свойства те же: Caption, Width, AutoSize, Alignment).
	// В шаблоне дерево убрано (не использовалось) — помощник оставлен на случай возврата TreeList.
	Sub SetupTreeColumns(LV: MetabaseTreeList);
	Var
		Col: ITreeListColumn;
	Begin
		Try
			If LV.Columns.Count = 0 Then
				Col := LV.Columns.Add;
				SetTreeColumn(Col, "Задача", 260, True, TextAlignment.Left);
				Col := LV.Columns.Add;
				SetTreeColumn(Col, "Тип", 120, False, TextAlignment.Left);
			Else
				SetTreeColumnsAutoSize(LV.Columns);
			End If;
		Except On e: Exception Do
			Debug.WriteLine("Планировщик: колонки дерева задач — " + e.Message);
		End Try;
	End Sub SetupTreeColumns;

	Sub SetupPanelLayout;
	Begin
		Self.Width := Double.RoundInt((1780 + PANEL_X_SHIFT + PANEL_X_GROW) * LayoutK);
		Self.Height := Double.RoundInt(1300 * LayoutK);

		// Контролы внутри блоков: Parent := группа (ребёнок поверх рамки). Координаты — от угла группы.
		// Блок «Затронутые задачи» убран (1.86): список затронутых = таблица плана в блоке «Раскладка».
		PlaceInGroup(UnavailRecordsList, "GrpPeriods", 12, 26, 912, 130);
		PlaceInGroup(UnavailStartDatePicker, "GrpPeriod", 12, 28, 230, 28);
		PlaceInGroup(UnavailStartTimePicker, "GrpPeriod", 250, 28, 130, 28);
		PlaceInGroup(UnavailEndDatePicker, "GrpPeriod", 388, 28, 230, 28);
		PlaceInGroup(UnavailEndTimePicker, "GrpPeriod", 626, 28, 130, 28);
		PlaceInGroup(PlanTable, "GrpPlan", 12, 79, 912, 440);
		PlaceInGroup(StoredPlanTable, "GrpStored", 12, 35, 660, 60);

		// Табличный вид списков (Style = Report — см. SetupPanelList) + колонки, если их нет
		SetupPanelList(UnavailRecordsList);
		SetupRecordsListColumns(UnavailRecordsList);
		SetupPanelList(PlanTable);
		SetupPlanTableColumns(PlanTable);
		PlanTable.OnClick := PlanTableOnClick;      // клик по ячейкам-«крестикам» (обрабатывать / не запускать)
		SetupPanelList(StoredPlanTable);
		SetupPlanTableColumns(StoredPlanTable);
		If Not IsNull(UnavailSummaryMemo) Then
			// Сводка по периоду — длинный текст: перенос строк + вертикальная полоса прокрутки
			// (IMemo.ScrollBars: ControlScrollStyle = None / Horizontal / Vertical / Both;
			//  по умолчанию None, поэтому в Инспекторе уже ничего задавать не нужно)
			Try
				UnavailSummaryMemo.WordWrap := True;
				UnavailSummaryMemo.ReadOnly := True;
				UnavailSummaryMemo.ScrollBars := ControlScrollStyle.Vertical;
			Except On e: Exception Do
				Debug.WriteLine("Недоступность: настройка Memo сводки — " + e.Message);
			End Try;
		End If;
		// Автомасштаб при изменении размеров окна: списки/таблицы/Memo панели тянутся по ширине.
		// ⚠ Наборы кнопок панели заменены меню (BtnExportStored, BtnDeletePlan, …) — их имён здесь
		// быть не должно: контролов с такими именами в форме нет, код бы не скомпилировался.
		SetAutoSize(UnavailRecordsList, True, False);
		SetAutoSize(PlanTable, True, False);
		SetAutoSize(StoredPlanTable, True, False);
		SetAutoSize(UnavailSummaryMemo, True, False);

		// Рамки блоков правой колонки (GROUP в описании экрана — создаёт фабрика)
		AnchorGroup("GrpPeriods", True, False);
		AnchorGroup("GrpPeriod", True, False);
		AnchorGroup("GrpMsg", True, False);
		AnchorGroup("GrpPlan", True, False);
		AnchorGroup("GrpStored", True, False);
	End Sub SetupPanelLayout;

	Sub ConfigurePeriodPickers;
	Begin
		Try
			// DateTimePickerKind (сборка Forms): 0 Date — ввод/выбор даты, 1 Time — времени
			UnavailStartDatePicker.Kind := DateTimePickerKind.Date;
			UnavailEndDatePicker.Kind := DateTimePickerKind.Date;
			UnavailStartTimePicker.Kind := DateTimePickerKind.Time;
			UnavailEndTimePicker.Kind := DateTimePickerKind.Time;
			UnavailStartDatePicker.Format := "dd.MM.yyyy";
			UnavailEndDatePicker.Format := "dd.MM.yyyy";
			UnavailStartTimePicker.Format := "HH:mm";
			UnavailEndTimePicker.Format := "HH:mm";
		Except On e: Exception Do
			Debug.WriteLine("Недоступность: формат пикеров — " + e.Message);
		End Try;
	End Sub ConfigurePeriodPickers;

	// Разложить период по четырём пикерам.
	// ВАЖНО: вид пикеров подтверждаем ДО записи значений (только Kind/Format, значения не сбрасываются) —
	// иначе время не отобразится в пикере-«времени» (Kind сброшен Инспектором / не привязан OnCreate).
	Sub SetPeriodPickers(StartDt: DateTime; EndDt: DateTime);
	Begin
		ConfigurePeriodPickers;
		UnavailStartDatePicker.CurrentDate := StartDt;
		UnavailStartTimePicker.CurrentDate := StartDt;
		UnavailEndDatePicker.CurrentDate := EndDt;
		UnavailEndTimePicker.CurrentDate := EndDt;
		Debug.WriteLine("Недоступность: период в пикеры — " + StartDt.ToString + " — " + EndDt.ToString);
	End Sub SetPeriodPickers;

	Sub FillUnavailPeriods;
	Var
		Item: IListViewItem;
		Rec: CUnavailRecord;
		I: Integer;
	Begin
		UnavailRecords := LoadUnavailRecords;
		UnavailRecordsList.Items.Clear;
		UnavailRecordKeys := New ArrayList.Create;
		If IsNull(UnavailRecords) Then
			Return;
		End If;
		UnavailRecordsList.Items.BeginUpdate;
		For I := 0 To UnavailRecords.Count - 1 Do
			Rec := UnavailRecords.Item(I) As CUnavailRecord;
			UnavailRecordKeys.Add(Rec.Key);
			// первый столбец задаётся при добавлении строки, остальные — через ColumnText
			UnavailRecordsList.Items.Add(Rec.StartDt.ToString);
			Item := UnavailRecordsList.Items.Item(UnavailRecordsList.Items.Count - 1);
			Item.ColumnText(1) := Rec.EndDt.ToString;
			Item.ColumnText(2) := Rec.Author;
			Item.ColumnText(3) := Rec.ChangedAt.ToString;
			If HasStoredPlan(Rec.Key) Then          // 4-я колонка — признак сохранённого плана
				Item.ColumnText(4) := "есть план";
			Else
				Item.ColumnText(4) := "—";
			End If;
		End For;
		UnavailRecordsList.Items.EndUpdate;
		SelectUnavailPeriodRow(UnavailSelectedKey);   // выбор записи не должен «слетать» после обновления
	End Sub FillUnavailPeriods;

	// Выделить строку списка периодов по ключу записи (UnavailSelectedKey) и прокрутить к ней.
	// Нужно, чтобы выбор сохранялся после «Обновить список периодов» и «Построить список»
	// (список пересобирается заново, и без этого выделение пропадало).
	Sub SelectUnavailPeriodRow(Key: Integer);
	Var
		Row: IListViewItem;
		I: Integer;
	Begin
		If IsNull(UnavailRecordsList) Or IsNull(UnavailRecordKeys) Then
			Return;
		End If;
		Try
			// снимаем отметку со всех строк (IListViewItem.Selected — «признак отметки элемента»)
			For I := 0 To UnavailRecordsList.Items.Count - 1 Do
				Row := UnavailRecordsList.Items.Item(I);
				If Not IsNull(Row) Then
					Row.Selected := False;
				End If;
			End For;
			If Key <= 0 Then
				Return;                              // Key = 0 — снять выделение (ручной ввод периода)
			End If;
			For I := 0 To UnavailRecordKeys.Count - 1 Do
				If (UnavailRecordKeys.Item(I) As Integer) = Key Then
					Row := UnavailRecordsList.Items.Item(I);
					If Not IsNull(Row) Then
						Row.Selected := True;
						Row.MakeVisible;                 // прокрутить список к выбранной строке
					End If;
					Return;
				End If;
			End For;
		Except On e: Exception Do
			Debug.WriteLine("Недоступность: выделение записи в списке периодов — " + e.Message);
		End Try;
	End Sub SelectUnavailPeriodRow;

	// Проставить/снять «обрабатывать» у всех пересекающихся задач (пункты меню «Отметки ▾»)
	Sub SetAllProcessed(Value: Boolean);
	Var
		Impact: CUnavailImpact;
		I, Cnt: Integer;
	Begin
		If IsNull(UnavailImpacts) Then
			Return;
		End If;
		Cnt := 0;
		For I := 0 To UnavailImpacts.Count - 1 Do
			Impact := UnavailImpacts.Item(I) As CUnavailImpact;
			SetImpactFlags(Impact, Value, False);   // снято — задача вне плана; стоит — «перепланировать»
			Cnt := Cnt + 1;
		End For;
		Debug.WriteLine("Недоступность: «обрабатывать» = " + Value.ToString + " у строк: " + Cnt.ToString);
	End Sub SetAllProcessed;

	// «Не запускать / перепланировать» для всех ОБРАБАТЫВАЕМЫХ строк (в колонке «Обрабатывать» крестик)
	Function ApplyProcessed(Decision: String): Integer;
	Var
		Impact: CUnavailImpact;
		I, Cnt: Integer;
	Begin
		Cnt := 0;
		If IsNull(UnavailImpacts) Then
			Return 0;
		End If;
		For I := 0 To UnavailImpacts.Count - 1 Do
			Impact := UnavailImpacts.Item(I) As CUnavailImpact;
			If ImpactProcessed(Impact) Then
				SetImpactFlags(Impact, True, Decision = DECISION_SKIP);
				Cnt := Cnt + 1;
			End If;
		End For;
		Return Cnt;
	End Function ApplyProcessed;

	// (работа с планом — только через таблицу СУБД: файловые сохранение/загрузка/CSV/HTML убраны 1.86)

	// здесь были Sub WritePlan / Sub ReadPlan — убраны вместе с файловыми операциями (1.86)



	Function UnavailImpactMatchesFilter(Impact: CUnavailImpact): Boolean;
	Var
		F: String;
	Begin
		F := String.ToLower(String.Trim(TableFilter));
		If F = "" Then
			Return True;
		End If;
		If TextContainsNoCase(Impact.Id, F) Then
			Return True;
		End If;
		If TextContainsNoCase(Impact.Name, F) Then
			Return True;
		End If;
		If TextContainsNoCase(Impact.BusinessApp, F) Then
			Return True;
		End If;
		If TextContainsNoCase(Impact.ResponsibleUser, F) Then
			Return True;
		End If;
		Return False;
	End Function UnavailImpactMatchesFilter;

	Function TextContainsNoCase(S: String; Needle: String): Boolean;
	Var
		Low: String;
	Begin
		Low := String.ToLower(S);
		Return Low.IndexOf(Needle) >= 0;
	End Function TextContainsNoCase;

	// Строка таблицы плана, выбранная пользователем (для пунктов «Решение ▾»).
	// Таблица плана может быть отфильтрована, поэтому строку находим по Id задачи (первая колонка).
	Function SelectedPlanImpact: CUnavailImpact;
	Var
		Item: IListViewItem;
		Id: String;
	Begin
		If IsNull(UnavailImpacts) Then
			Return Null;
		End If;
		Item := PlanTable.SelectedItem;
		If IsNull(Item) Then
			Item := PlanTable.FocusedItem;           // клик мог ещё не изменить SelectedItem
		End If;
		If IsNull(Item) Then
			Return Null;
		End If;
		Id := Item.Text;                             // первая колонка = TASK_ID (см. FillPlanTable)
		Return FindImpactById(UnavailImpacts, Id);
	End Function SelectedPlanImpact;

	// Колонка таблицы плана по координате X (пиксели от левого края списка); -1 — не определили.
	// Сумму ширин колонок берём из самих колонок, поэтому горизонтальной прокрутки быть не должно
	// (ширины подобраны в UnavailPlanColumnWidth с запасом).
	Function PlanTableColumnAt(X: Integer): Integer;
	Var
		Sum, I: Integer;
	Begin
		Sum := 0;
		For I := 0 To PlanTable.Columns.Count - 1 Do
			Sum := Sum + (PlanTable.Columns.Item(I) As IListViewColumn).Width;
			If X < Sum Then
				Return I;
			End If;
		End For;
		Return -1;
	End Function PlanTableColumnAt;

	// Клик по таблице плана: переключаем «крестики» колонок «Обрабатывать» / «Не запускать».
	// Колонка определяется по координате X; если распознали не «крестик» (шапка, другие колонки) —
	// ничего не меняем. Те же действия доступны пунктами меню «Отметки ▾» / «Решение ▾».
	Sub PlanTableOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		Col: Integer;
		Impact: CUnavailImpact;
	Begin
		Impact := SelectedPlanImpact;
		If IsNull(Impact) Then
			Return;
		End If;
		Col := PlanTableColumnAt(Args.pPoint.X);
		If Col = UNAVAIL_COL_PROCESS Then
			SetImpactFlags(Impact, Not ImpactProcessed(Impact), False);
		Else
			If Col = UNAVAIL_COL_SKIP Then
				SetImpactFlags(Impact, True, Not ImpactSkipped(Impact));
			Else
				Return;                              // клик не по «крестику»
			End If;
		End If;
		Debug.WriteLine("Недоступность: «" + Impact.Id + "» — обрабатывать "
			+ ImpactProcessed(Impact).ToString + ", не запускать " + ImpactSkipped(Impact).ToString);
		RenderUnavailSummary;
	End Sub PlanTableOnClick;

	// «Пересчитать план»: окно параметров (начало / число слоёв / желаемое окончание) →
	// раскладка DistributeScheduleLayers (слои набиваются плотно, см. UnavailabilityPlanner.fore)
	Sub RecalcPlanOnClick(Sender: Object; Args: IMouseEventArgs);
	Var
		F: PLANPARAMSForm;
		Sent: Variant;
		DefaultStart: DateTime;
		DefaultLayers: Integer;
	Begin
		If IsNull(UnavailImpacts) Then
			WinApplication.InformationBox("Сначала постройте список затронутых задач («Построить список»)");
			Return;
		End If;
		DefaultStart := UnavailWindow.Stop;          // по умолчанию начало плана = окончание простоя
		DefaultLayers := PlanLayersForFinish(UnavailImpacts, DefaultStart,
			DateTime.AddSeconds(DefaultStart, UnavailWindow.TailHours * 3600));   // по хвостовому окну
		Try
			F := New PLANPARAMSForm.CreateForm(Self As IWin32Window);
			F.SendCommand("SetCaption", "Параметры плана недоступности");
			F.SendCommand("SetStart", DefaultStart.ToString);          // начало плана
			F.SendCommand("SetLayers", DefaultLayers.ToString);        // слоёв (по хвостовому окну)
			F.SendCommand("SetFinish", UnavailWindow.Stop.ToString);   // подсказка для «желаемого окончания»
			F.ShowModal;                             // закрывается крестиком окна
			Sent := F.SendCommand("GetParams", Null);
			ApplyPlanParams(UnvVarToStr(Sent));
		Except On e: Exception Do
			Debug.WriteLine("Недоступность: окно параметров плана — " + e.Message);
			WinApplication.InformationBox("Не удалось открыть параметры плана: " + e.Message);
		End Try;
	End Sub RecalcPlanOnClick;

	// Разбор ответа окна параметров: "applied|layers|start|finish". finish не пусто — слои считаем
	// по желаемому окончанию (PlanLayersForFinish), иначе берём слои, заданные пользователем.
	Sub ApplyPlanParams(S: String);
	Var
		Parts: ArrayList;
		Layers: Integer;
		PlanStart, Finish: DateTime;
	Begin
		Parts := SplitByChar(S, "|");
		If Parts.Count < 4 Then
			Return;
		End If;
		If UnvVarToStr(Parts.Item(0)) <> "1" Then
			Return;                                  // «Отмена» — план не пересчитываем
		End If;
		Layers := UnvVarToInt(Parts.Item(1));
		PlanStart := UnvVarToDate(Parts.Item(2));
		If UnvVarToStr(Parts.Item(3)) <> "" Then
			Finish := UnvVarToDate(Parts.Item(3));
			If Finish > PlanStart Then
				Layers := PlanLayersForFinish(UnavailImpacts, PlanStart, Finish);
			End If;
		End If;
		If Layers < 1 Then
			Layers := 1;
		End If;
		DistributeScheduleLayers(UnavailImpacts, PlanStart, Layers);
		RenderUnavailSummary;
		SetMemoLines(UnavailSummaryMemo, "План пересчитан: слоёв " + Layers.ToString
			+ ", начало " + PlanStart.ToString + UNAVAIL_CRLF
			+ UnavailPlanHeaderText(UnavailImpacts, UnavailWindow));
	End Sub ApplyPlanParams;

	// Разбить строку по символу-разделителю (Split в Fore нет: используем IndexOf/SubString)
	Function SplitByChar(S: String; Sep: String): ArrayList;
	Var
		Parts: ArrayList;
		Rest, Part: String;
		P: Integer;
	Begin
		Parts := New ArrayList.Create;
		Rest := S;
		While Rest <> "" Do
			P := Rest.IndexOf(Sep);
			If P < 0 Then
				Parts.Add(Rest);
				Rest := "";
			Else
				Part := Rest.SubString(0, P);
				Parts.Add(Part);
				Rest := Rest.SubString(P + 1, Rest.Length - P - 1);
			End If;
		End While;
		If S = "" Then
			Parts.Add("");
		End If;
		Return Parts;
	End Function SplitByChar;

	Sub FillPlanTable;
	Var
		Item: IListViewItem;
		Impact: CUnavailImpact;
		C, I: Integer;
	Begin
		PlanTable.Items.Clear;
		If IsNull(UnavailImpacts) Then
			Return;
		End If;
		PlanTable.Items.BeginUpdate;
		For I := 0 To UnavailImpacts.Count - 1 Do
			Impact := UnavailImpacts.Item(I) As CUnavailImpact;
			// фильтр: показываем только строки, совпавшие с введённым текстом
			If UnavailImpactMatchesFilter(Impact) Then
				// первый столбец (TASK_ID) задаётся при добавлении строки, остальные — через ColumnText
				PlanTable.Items.Add(UnavailPlanCell(Impact, UNAVAIL_COL_TASK_ID));
				Item := PlanTable.Items.Item(PlanTable.Items.Count - 1);
				For C := UNAVAIL_COL_TASK_ID + 1 To UNAVAIL_PLAN_COLUMNS - 1 Do
					Item.ColumnText(C) := UnavailPlanCell(Impact, C);
				End For;
			End If;
		End For;
		PlanTable.Items.EndUpdate;
	End Sub FillPlanTable;

	Sub RenderUnavailSummary;
	Begin
		If IsNull(UnavailImpacts) Then
			Return;
		End If;
		SetMemoLines(UnavailSummaryMemo, UnavailPlanHeaderText(UnavailImpacts, UnavailWindow));
		UpdateStatusLine;                       // строка статуса в блоке «Затронутые задачи»
		FillPlanTable;
	End Sub RenderUnavailSummary;

	Function SelectedUnavailPeriodKey: Integer;
	Var
		Item: IListViewItem;
	Begin
		If IsNull(UnavailRecordsList.SelectedItem) Then
			Return 0;
		End If;
		Item := UnavailRecordsList.SelectedItem;   // тип уже IListViewItem — привод не нужен
		If (Item.Index < 0) Or (Item.Index >= UnavailRecordKeys.Count) Then
			Return 0;
		End If;
		Return UnavailRecordKeys.Item(Item.Index) As Integer;
	End Function SelectedUnavailPeriodKey;

	// Задача, выбранная в таблице плана (для пунктов «Решение ▾» и клика по «крестикам»)
	Function SelectedUnavailImpact: CUnavailImpact;
	Begin
		Return SelectedPlanImpact;
	End Function SelectedUnavailImpact;

	Function BuildForbiddenWindows: ArrayList;
	Var
		Records: ArrayList;
		Rec: CUnavailRecord;
		W: CPlanWindow;
		Windows: ArrayList;
		I: Integer;
	Begin
		Windows := New ArrayList.Create;
		Records := LoadUnavailRecords;
		For I := 0 To Records.Count - 1 Do
			Rec := Records.Item(I) As CUnavailRecord;
			W := New CPlanWindow.Create;
			W.StartDt := Rec.StartDt;
			W.EndDt := Rec.EndDt;
			Windows.Add(W);
		End For;
		
		Return Windows;
	End Function BuildForbiddenWindows;

End Class SCHEDULERForm;